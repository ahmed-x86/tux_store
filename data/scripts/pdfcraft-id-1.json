{
  "schema": 2,
  "id": "pdfcraft-id-1",
  "title": "Install PdfCraft",
  "description": "PdfCraft is an open-source PDF workbench: read, organize, combine, split and secure PDFs. This downloads the latest Linux AppImage from GitHub, packages it into a native pacman package (icon + desktop entry + a pdfcraft command), and installs it — no manual extracting or building needed.",
  "version": {
    "label": "Latest PdfCraft version",
    "script": "latest-version.sh"
  },
  "author": "Community",
  "keywords": [
    "pdfcraft",
    "artcraft",
    "craft apps",
    "pdf",
    "pdf editor",
    "merge pdf",
    "split pdf",
    "acrobat",
    "appimage",
    "قارئ pdf",
    "دمج pdf",
    "تقسيم pdf",
    "ملفات pdf"
  ],
  "show_on_home": true,
  "categories": [
    "artcraft",
    "office"
  ],
  "info": {
    "download_mb": 110,
    "installed_mb": 111,
    "extracted_mb": 0,
    "note": "Sizes are approximate; PdfCraft's own AppImage size may change over time."
  },
  "icon": [
    {
      "file": "pdfcraft-id-1.png"
    }
  ],
  "vars": {
    "preflight": "",
    "latest_version": "",
    "installed_version": ""
  },
  "start": "welcome",
  "uninstall": "un_start",
  "steps": {
    "welcome": {
      "type": "dialog",
      "title": "Install PdfCraft",
      "tone": "info",
      "message": [
        "PdfCraft is part of the ArtCraft suite — an open-source PDF workbench: read, organize, combine, split and secure PDFs.",
        "",
        "This add-on downloads the official Linux AppImage from GitHub, builds a small native package from it (pacman), and installs it with its icon and a menu shortcut.",
        "",
        "Nothing is modified inside PdfCraft itself — only how it's packaged for your system."
      ],
      "buttons": [
        {
          "label": "Continue",
          "style": "primary",
          "goto": "preflight"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "preflight": {
      "type": "check",
      "command": {
        "label": "Checking your system…",
        "script": "checking-requirements.sh"
      },
      "capture": "preflight",
      "on_success": "preflight_result",
      "on_failure": "error_generic"
    },
    "preflight_result": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "preflight",
            "ne": ""
          },
          "goto": "preflight_failed"
        }
      ],
      "default": "detect_version"
    },
    "preflight_failed": {
      "type": "dialog",
      "title": "Not ready yet",
      "tone": "warning",
      "message": "${preflight}",
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    },
    "detect_version": {
      "type": "check",
      "command": {
        "label": "Checking the latest PdfCraft version…",
        "script": "latest-version.sh"
      },
      "capture": "latest_version",
      "on_success": "confirm",
      "on_failure": "error_generic"
    },
    "confirm": {
      "type": "dialog",
      "title": "Install PdfCraft ${latest_version}",
      "tone": "info",
      "message": [
        "Ready to download and install PdfCraft ${latest_version}.",
        "",
        "This will download the AppImage, package it for pacman, and ask for your password once to install it."
      ],
      "buttons": [
        {
          "label": "Install",
          "style": "primary",
          "goto": "download_step"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "download_step": {
      "type": "run",
      "title": "Downloading PdfCraft…",
      "message": "Please wait.",
      "commands": [
        {
          "label": "Downloading the AppImage",
          "script": "download-appimage.sh",
          "progress": "percent",
          "percent": 40,
          "expected_secs": 60
        }
      ],
      "on_success": "build_step",
      "on_failure": "install_failed"
    },
    "build_step": {
      "type": "run",
      "title": "Packaging PdfCraft…",
      "message": "Building a pacman package from the AppImage.",
      "commands": [
        {
          "label": "Building the package",
          "script": "build-package.sh",
          "percent": 70,
          "expected_secs": 30
        }
      ],
      "on_success": "install_step",
      "on_failure": "install_failed"
    },
    "install_step": {
      "type": "run",
      "title": "Installing PdfCraft…",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Installing the package (admin password required)",
          "script": "install-package.sh",
          "root": true,
          "percent": 95
        },
        {
          "label": "Cleaning up temporary files",
          "script": "cleanup-after-install.sh",
          "ignore_failure": true,
          "percent": 100
        }
      ],
      "on_success": "verify",
      "on_failure": "install_failed"
    },
    "verify": {
      "type": "check",
      "command": {
        "label": "Verifying the installation…",
        "script": "reading-installed-version.sh"
      },
      "capture": "installed_version",
      "on_success": "verify_result",
      "on_failure": "install_failed"
    },
    "verify_result": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "installed_version",
            "eq": ""
          },
          "goto": "install_failed"
        }
      ],
      "default": "record_install"
    },
    "record_install": {
      "type": "record",
      "set": {
        "installed_version": "${installed_version}"
      },
      "packages": [
        "pdfcraft"
      ],
      "next": "done"
    },
    "done": {
      "type": "finish",
      "success": true,
      "title": "PdfCraft installed",
      "button": "Close",
      "mark": "installed",
      "message": [
        "PdfCraft ${installed_version} is installed.",
        "",
        "Open it from your applications menu, or run “pdfcraft” from a terminal."
      ]
    },
    "install_failed": {
      "type": "dialog",
      "title": "The installation did not finish",
      "tone": "error",
      "message": [
        "Something went wrong (step: ${last_failed}). Use “Show details” to read the output.",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    },
    "error_generic": {
      "type": "dialog",
      "title": "A check failed",
      "tone": "error",
      "message": [
        "“${last_failed}” did not work (exit code ${last_exit_code}).",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    },
    "un_start": {
      "type": "dialog",
      "title": "Remove PdfCraft?",
      "tone": "warning",
      "message": [
        "This removes the pdfcraft package (and dependencies nothing else needs).",
        "Your project files are not touched — only the app itself is removed."
      ],
      "buttons": [
        {
          "label": "Remove PdfCraft",
          "style": "danger",
          "goto": "un_run"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "un_run": {
      "type": "run",
      "title": "Removing PdfCraft…",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Removing the package (admin password required)",
          "script": "removing-pdfcraft.sh",
          "root": true,
          "percent": 100
        }
      ],
      "on_success": "un_done",
      "on_failure": "un_failed"
    },
    "un_done": {
      "type": "finish",
      "success": true,
      "mark": "uninstalled",
      "title": "PdfCraft removed",
      "message": "PdfCraft was removed from your computer."
    },
    "un_failed": {
      "type": "dialog",
      "title": "PdfCraft could not be removed",
      "tone": "error",
      "message": [
        "Step: ${last_failed}. Use “Show details” to read the output.",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    }
  }
}