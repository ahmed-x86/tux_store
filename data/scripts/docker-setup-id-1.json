{
  "schema": 2,
  "id": "docker-setup-id-1",
  "title": "Docker",
  "description": "Install Docker with Compose and Buildx, start the service and let your user run it without sudo.",
  "author": "Tux Store",
  "keywords": [
    "docker",
    "container",
    "containers",
    "compose",
    "buildx",
    "devops",
    "حاويات",
    "دوكر"
  ],
  "show_on_home": true,
  "vars": {
    "new_pkgs": "",
    "skipped_pkgs": "",
    "skipped_text": "",
    "preflight": "",
    "verify_msg": "",
    "profile": "basic",
    "pkgs": "docker docker-compose docker-buildx"
  },
  "info": {
    "download_mb": {
      "label": "Download size",
      "script": "download-size.sh"
    },
    "installed_mb": {
      "label": "Installed size",
      "script": "installed-size.sh"
    },
    "extracted_mb": 20,
    "note": "Images and containers you created stay in /var/lib/docker after removal."
  },
  "icon": [
    {
      "file": "docker-setup-id-1.svg"
    }
  ],
  "start": "welcome",
  "uninstall": "un_start",
  "steps": {
    "welcome": {
      "type": "dialog",
      "title": "Docker",
      "tone": "info",
      "message": [
        "Run containers with Docker.",
        "",
        "This installs Docker, Compose and Buildx, enables the docker service and adds your user to the \"docker\" group.",
        "Careful: members of the docker group can gain full root access on this computer. Only continue if that is acceptable."
      ],
      "buttons": [
        {
          "label": "Continue",
          "style": "primary",
          "goto": "preflight"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "preflight": {
      "type": "check",
      "command": {
        "label": "Checking your system…",
        "script": "checking-your-system.sh"
      },
      "capture": "preflight",
      "on_success": "preflight_gate",
      "on_failure": "error_generic"
    },
    "preflight_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "preflight",
            "ne": ""
          },
          "goto": "problem"
        }
      ],
      "default": "find_missing"
    },
    "problem": {
      "type": "dialog",
      "title": "Cannot continue",
      "tone": "error",
      "message": "${preflight}",
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    },
    "find_missing": {
      "type": "check",
      "command": {
        "label": "Looking at what is already installed…",
        "timeout_secs": 60,
        "script": "looking-at-what-is-already-installed.sh"
      },
      "capture": "new_pkgs",
      "on_success": "find_skipped",
      "on_failure": "error_generic"
    },
    "find_skipped": {
      "type": "check",
      "command": {
        "label": "Checking the repositories…",
        "timeout_secs": 60,
        "script": "checking-the-repositories.sh"
      },
      "capture": "skipped_pkgs",
      "on_success": "missing_gate",
      "on_failure": "error_generic"
    },
    "missing_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "new_pkgs",
            "eq": ""
          },
          "goto": "confirm_config"
        },
        {
          "when": {
            "var": "skipped_pkgs",
            "ne": ""
          },
          "goto": "skipped_line"
        }
      ],
      "default": "confirm"
    },
    "skipped_line": {
      "type": "set",
      "vars": {
        "skipped_text": "Not in your repositories (skipped): ${skipped_pkgs}"
      },
      "next": "confirm"
    },
    "confirm": {
      "type": "dialog",
      "title": "Ready to install",
      "tone": "info",
      "message": [
        "This will be installed:",
        "${new_pkgs}",
        "",
        "${skipped_text}",
        "",
        "You will be asked for your password."
      ],
      "buttons": [
        {
          "label": "Install",
          "style": "primary",
          "goto": "install"
        },
        {
          "label": "Back",
          "goto": "welcome"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "confirm_config": {
      "type": "dialog",
      "title": "Ready to set up",
      "tone": "info",
      "message": [
        "Docker is already installed, so no packages will be added.",
        "This will only enable the docker service and add your user to the \"docker\" group.",
        "Careful: members of the docker group can gain full root access on this computer.",
        "",
        "You will be asked for your password."
      ],
      "buttons": [
        {
          "label": "Continue",
          "style": "primary",
          "goto": "install"
        },
        {
          "label": "Back",
          "goto": "welcome"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "install": {
      "type": "run",
      "title": "Setting up: Docker",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Installing packages",
          "root": true,
          "weight": 10,
          "expected_secs": 60,
          "percent": 70,
          "script": "installing-packages.sh"
        },
        {
          "label": "Starting Docker and adding your user",
          "root": true,
          "expected_secs": 10,
          "percent": 95,
          "script": "starting-docker-and-adding-your-user.sh"
        }
      ],
      "on_success": "verify",
      "on_failure": "install_failed"
    },
    "verify": {
      "type": "check",
      "command": {
        "label": "Checking the result…",
        "timeout_secs": 60,
        "script": "checking-the-result.sh"
      },
      "capture": "verify_msg",
      "on_success": "after_verify",
      "on_failure": "install_failed"
    },
    "after_verify": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "new_pkgs",
            "eq": ""
          },
          "goto": "done"
        }
      ],
      "default": "record_install"
    },
    "record_install": {
      "type": "record",
      "set": {
        "installed_profile": "${profile}"
      },
      "packages": [
        "${new_pkgs}"
      ],
      "next": "done"
    },
    "done": {
      "type": "finish",
      "title": "Docker is ready",
      "success": true,
      "mark": "installed",
      "button": "Close",
      "message": [
        "Docker is installed and running.",
        "Log out and back in so the new group takes effect, then try: docker run hello-world"
      ]
    },
    "install_failed": {
      "type": "dialog",
      "title": "Installation failed",
      "tone": "error",
      "message": [
        "${last_failed}",
        "${verify_msg}",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    },
    "error_generic": {
      "type": "dialog",
      "title": "Something went wrong",
      "tone": "error",
      "message": "The system check could not run. Please try again.",
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    },
    "un_start": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "recorded_packages",
            "eq": ""
          },
          "goto": "un_nothing"
        }
      ],
      "default": "un_confirm"
    },
    "un_nothing": {
      "type": "finish",
      "title": "Nothing to remove",
      "success": true,
      "mark": "uninstalled",
      "button": "Close",
      "message": [
        "These packages were already on your system before this add-on, so Tux Store keeps them.",
        "This add-on is now marked as not installed."
      ]
    },
    "un_confirm": {
      "type": "dialog",
      "title": "Remove Docker?",
      "tone": "warning",
      "message": [
        "These packages were installed by this add-on and will be removed:",
        "${recorded_packages}",
        "",
        "The docker service will be stopped and your user removed from the \"docker\" group.",
        "Your images and containers in /var/lib/docker are not deleted.",
        "A package that other software still needs is kept.",
        "",
        "You will be asked for your password."
      ],
      "buttons": [
        {
          "label": "Remove",
          "style": "danger",
          "goto": "un_preflight"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "un_preflight": {
      "type": "check",
      "command": {
        "label": "Checking your system…",
        "script": "checking-your-system-2.sh"
      },
      "capture": "preflight",
      "on_success": "un_gate",
      "on_failure": "error_generic"
    },
    "un_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "preflight",
            "ne": ""
          },
          "goto": "problem"
        }
      ],
      "default": "un_run"
    },
    "un_run": {
      "type": "run",
      "title": "Removing Docker…",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Stopping Docker",
          "root": true,
          "expected_secs": 10,
          "percent": 40,
          "script": "stopping-docker.sh"
        },
        {
          "label": "Removing packages",
          "root": true,
          "expected_secs": 20,
          "percent": 95,
          "script": "removing-packages.sh"
        }
      ],
      "on_success": "un_done",
      "on_failure": "un_failed"
    },
    "un_done": {
      "type": "finish",
      "title": "Docker removed",
      "success": true,
      "mark": "uninstalled",
      "button": "Close",
      "message": "Docker was stopped and the packages this add-on installed were removed. Your images and containers stay in /var/lib/docker."
    },
    "un_failed": {
      "type": "dialog",
      "title": "Removal failed",
      "tone": "error",
      "message": [
        "${last_failed}",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    }
  }
}
