{
  "schema": 2,
  "id": "hello-test-id-2",
  "title": "Hello test script",
  "description": "A tiny harmless script to try the script system. It only prints a few lines.",
  "version": {
    "label": "Today's version",
    "shell": "date +%Y.%m.%d"
  },
  "author": "You",
  "keywords": [
    "hello",
    "test",
    "demo"
  ],
  "show_on_home": true,
  "start": "welcome",
  "steps": {
    "welcome": {
      "type": "dialog",
      "title": "Hello!",
      "message": "This is a test script. It does not change anything on your system.",
      "buttons": [
        {
          "label": "Continue",
          "style": "primary",
          "goto": "detect_helpers"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "pick": {
      "type": "choice",
      "title": "Pick a greeting",
      "store_as": "greeting",
      "next": "say_in_terminal",
      "options": [
        {
          "value": "Hello",
          "label": "Hello",
          "hint": "A friendly greeting."
        },
        {
          "value": "Marhaba",
          "label": "Marhaba",
          "hint": "The Arabic one."
        }
      ],
      "buttons": [
        {
          "label": "Back",
          "goto": "helper_result"
        }
      ]
    },
    "run": {
      "type": "run",
      "title": "Working…",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Saying hello",
          "argv": [
            "echo",
            "${greeting} from Tux Store!"
          ],
          "percent": 40
        },
        {
          "label": "Creating a small file",
          "shell": [
            "mkdir -p \"$HOME/.local/share/tux-hello\"",
            "echo \"$TUX_VAR_GREETING from Tux Store\" > \"$HOME/.local/share/tux-hello/hello.txt\""
          ],
          "percent": 65
        },
        {
          "label": "Waiting a moment",
          "shell": "sleep 2; echo done",
          "expected_secs": 2,
          "percent": 90
        }
      ],
      "on_success": "remember",
      "echo": true
    },
    "done": {
      "type": "finish",
      "title": "All done",
      "message": "${helper_msg}\n\nYou picked “${greeting}”. A small file was created in ~/.local/share/tux-hello (you can remove it with Uninstall).",
      "mark": "installed"
    },
    "detect_helpers": {
      "type": "check",
      "command": {
        "label": "Looking for yay and paru…",
        "shell": [
          "y=0; p=0",
          "command -v yay >/dev/null 2>&1 && y=1",
          "command -v paru >/dev/null 2>&1 && p=1",
          "if [ $y = 1 ] && [ $p = 1 ]; then echo both",
          "elif [ $y = 1 ]; then echo yay",
          "elif [ $p = 1 ]; then echo paru",
          "else echo none; fi"
        ]
      },
      "capture": "helpers",
      "on_success": "helper_branch",
      "on_failure": "helper_branch"
    },
    "helper_branch": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "helpers",
            "eq": "both"
          },
          "goto": "set_both"
        },
        {
          "when": {
            "var": "helpers",
            "eq": "yay"
          },
          "goto": "set_yay"
        },
        {
          "when": {
            "var": "helpers",
            "eq": "paru"
          },
          "goto": "set_paru"
        }
      ],
      "default": "set_none"
    },
    "set_both": {
      "type": "set",
      "vars": {
        "helper_msg": "Both yay and paru are installed."
      },
      "next": "helper_result"
    },
    "set_yay": {
      "type": "set",
      "vars": {
        "helper_msg": "yay is installed (paru is not)."
      },
      "next": "helper_result"
    },
    "set_paru": {
      "type": "set",
      "vars": {
        "helper_msg": "paru is installed (yay is not)."
      },
      "next": "helper_result"
    },
    "set_none": {
      "type": "set",
      "vars": {
        "helper_msg": "Neither yay nor paru is installed."
      },
      "next": "helper_result"
    },
    "helper_result": {
      "type": "dialog",
      "title": "AUR helpers",
      "message": "${helper_msg}",
      "buttons": [
        {
          "label": "Continue",
          "style": "primary",
          "goto": "pick"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "say_in_terminal": {
      "type": "print",
      "text": "hello add-on: the user picked ${greeting}",
      "next": "run"
    },
    "remember": {
      "type": "record",
      "files": [
        "~/.local/share/tux-hello"
      ],
      "next": "done"
    },
    "un_confirm": {
      "type": "dialog",
      "title": "Remove the hello files?",
      "message": "This deletes: ${recorded_files}",
      "buttons": [
        {
          "label": "Remove",
          "style": "danger",
          "goto": "un_run"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "un_run": {
      "type": "run",
      "title": "Removing…",
      "message": "Please wait.",
      "commands": [
        {
          "label": "Deleting the recorded files",
          "percent": 100,
          "shell": [
            "printf '%s\\n' \"$TUX_VAR_RECORDED_FILES\" | while IFS= read -r f; do",
            "  case \"$f\" in \"$HOME\"/*) rm -rf -- \"$f\"; echo \"removed $f\" ;; *) echo \"skipped $f\" ;; esac",
            "done"
          ]
        }
      ],
      "on_success": "un_done"
    },
    "un_done": {
      "type": "finish",
      "title": "Removed",
      "message": "The hello files were deleted.",
      "mark": "uninstalled"
    }
  },
  "info": {
    "download_mb": {
      "shell": "echo 2"
    },
    "extracted_mb": 3,
    "installed_mb": 1,
    "note": "The version and the download size of this test are computed by commands."
  },
  "icon": [
    {
      "file": "hello-test-id-2.svg"
    },
    {
      "theme": "face-smile"
    }
  ],
  "uninstall": "un_confirm"
}