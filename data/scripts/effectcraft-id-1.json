{
  "schema": 2,
  "id": "effectcraft-id-1",
  "title": "Install EffectCraft",
  "description": "EffectCraft is an open-source motion graphics and visual effects app — an After Effects-style tool. This downloads the latest Linux AppImage from GitHub, You choose how to install it: wrap the official AppImage into a local pacman package (icon + desktop entry + a effectcraft command), or install the official native Arch package (.pkg.tar.zst) directly. The latest version is detected automatically.",
  "version": {
    "label": "Latest EffectCraft version",
    "script": "latest-version.sh"
  },
  "author": "Tux Store Team",
  "keywords": [
    "effectcraft",
    "artcraft",
    "craft apps",
    "motion graphics",
    "vfx",
    "after effects",
    "compositing",
    "effects",
    "appimage",
    "ارت كرافت",
    "برامج كرافت",
    "adobe",
    "ادوبي",
    "إيفيكت كرافت",
    "موشن جرافيك",
    "مؤثرات بصرية",
    "افتر افكتس",
    "تأثيرات",
    "motion design",
    "visual effects",
    "video effects",
    "animation",
    "adobe after effects",
    "موشن",
    "فيديو",
    "تحريك",
    "مونتاج"
  ],
  "show_on_home": false,
  "categories": [
    "artcraft",
    "audio-video"
  ],
  "info": {
    "download_mb": 72,
    "installed_mb": 73,
    "extracted_mb": 0,
    "note": "Sizes are for the AppImage method; the native package may differ slightly. EffectCraft's release size may change over time."
  },
  "icon": [
    {
      "file": "effectcraft-id-1.png"
    }
  ],
  "vars": {
    "preflight": "",
    "latest_version": "",
    "installed_version": "",
    "method": "appimage",
    "method_label": "",
    "native_pkg": ""
  },
  "start": "welcome",
  "uninstall": "un_start",
  "steps": {
    "welcome": {
      "type": "dialog",
      "title": "Install EffectCraft",
      "tone": "info",
      "message": [
        "EffectCraft is part of the ArtCraft suite — an open-source motion graphics and visual effects app — an After Effects-style tool.",
        "",
        "On the next screen you choose how to install it: wrap the official AppImage into a local pacman package, or install the official native Arch package directly.",
        "",
        "Either way you get the official release from GitHub — nothing inside EffectCraft is modified."
      ],
      "buttons": [
        {
          "label": "Continue",
          "style": "primary",
          "goto": "choose_method"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "choose_method": {
      "type": "choice",
      "title": "Choose the installation method",
      "store_as": "method",
      "default": "appimage",
      "next": "preflight",
      "continue_label": "Continue",
      "options": [
        {
          "value": "appimage",
          "label": "AppImage, wrapped as a pacman package",
          "hint": "Downloads the official AppImage and packages it locally with makepkg (icon, menu entry and a command). Needs base-devel and fuse2.",
          "set": {
            "method_label": "AppImage wrapped as a pacman package"
          }
        },
        {
          "value": "native",
          "label": "Native Arch package",
          "hint": "Downloads the official ready-made .pkg.tar.zst from GitHub and installs it directly with pacman. No local build; dependencies come from your repositories.",
          "set": {
            "method_label": "Native Arch package (.pkg.tar.zst)"
          }
        }
      ],
      "buttons": [
        {
          "label": "Back",
          "goto": "welcome"
        }
      ]
    },
    "preflight": {
      "type": "check",
      "command": {
        "label": "Checking your system…",
        "script": "checking-requirements.sh"
      },
      "capture": "preflight",
      "on_success": "preflight_result",
      "on_failure": "error_generic"
    },
    "preflight_result": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "preflight",
            "ne": ""
          },
          "goto": "preflight_failed"
        }
      ],
      "default": "detect_version"
    },
    "preflight_failed": {
      "type": "dialog",
      "title": "Not ready yet",
      "tone": "warning",
      "message": "${preflight}",
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    },
    "detect_version": {
      "type": "check",
      "command": {
        "label": "Checking the latest EffectCraft version…",
        "script": "latest-version.sh"
      },
      "capture": "latest_version",
      "on_success": "confirm",
      "on_failure": "error_generic"
    },
    "confirm": {
      "type": "dialog",
      "title": "Install EffectCraft ${latest_version}",
      "tone": "info",
      "message": [
        "Ready to install EffectCraft ${latest_version}.",
        "",
        "Method: ${method_label}",
        "",
        "You will be asked for your password once to install the package."
      ],
      "buttons": [
        {
          "label": "Install",
          "style": "primary",
          "goto": "route"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "route": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "method",
            "eq": "native"
          },
          "goto": "native_download_step"
        }
      ],
      "default": "download_step"
    },
    "download_step": {
      "type": "run",
      "title": "Downloading EffectCraft…",
      "message": "Please wait.",
      "commands": [
        {
          "label": "Downloading the AppImage",
          "script": "download-appimage.sh",
          "progress": "percent",
          "percent": 40,
          "expected_secs": 60
        }
      ],
      "on_success": "build_step",
      "on_failure": "install_failed"
    },
    "build_step": {
      "type": "run",
      "title": "Packaging EffectCraft…",
      "message": "Building a pacman package from the AppImage.",
      "commands": [
        {
          "label": "Building the package",
          "script": "build-package.sh",
          "percent": 70,
          "expected_secs": 30
        }
      ],
      "on_success": "install_step",
      "on_failure": "install_failed"
    },
    "install_step": {
      "type": "run",
      "title": "Installing EffectCraft…",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Installing the package (admin password required)",
          "script": "install-package.sh",
          "root": true,
          "percent": 95
        },
        {
          "label": "Cleaning up temporary files",
          "script": "cleanup-after-install.sh",
          "ignore_failure": true,
          "percent": 100
        }
      ],
      "on_success": "verify",
      "on_failure": "install_failed"
    },
    "native_download_step": {
      "type": "run",
      "title": "Downloading EffectCraft…",
      "message": "Downloading the official Arch package.",
      "commands": [
        {
          "label": "Downloading the native package",
          "script": "download-native.sh",
          "progress": "percent",
          "percent": 70,
          "expected_secs": 40
        }
      ],
      "on_success": "native_name_step",
      "on_failure": "install_failed"
    },
    "native_name_step": {
      "type": "check",
      "command": {
        "label": "Reading the package info…",
        "script": "reading-native-package-name.sh"
      },
      "capture": "native_pkg",
      "on_success": "native_install_step",
      "on_failure": "install_failed"
    },
    "native_install_step": {
      "type": "run",
      "title": "Installing EffectCraft…",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Installing the package (admin password required)",
          "script": "install-native-package.sh",
          "root": true,
          "percent": 95
        },
        {
          "label": "Cleaning up temporary files",
          "script": "cleanup-after-install.sh",
          "ignore_failure": true,
          "percent": 100
        }
      ],
      "on_success": "verify",
      "on_failure": "install_failed"
    },
    "verify": {
      "type": "check",
      "command": {
        "label": "Verifying the installation…",
        "script": "reading-installed-version.sh"
      },
      "capture": "installed_version",
      "on_success": "verify_result",
      "on_failure": "install_failed"
    },
    "verify_result": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "installed_version",
            "eq": ""
          },
          "goto": "install_failed"
        },
        {
          "when": {
            "var": "method",
            "eq": "native"
          },
          "goto": "record_install_native"
        }
      ],
      "default": "record_install"
    },
    "record_install": {
      "type": "record",
      "set": {
        "installed_version": "${installed_version}"
      },
      "packages": [
        "effectcraft"
      ],
      "next": "done"
    },
    "record_install_native": {
      "type": "record",
      "set": {
        "installed_version": "${installed_version}"
      },
      "packages": [
        "${native_pkg}"
      ],
      "next": "done"
    },
    "done": {
      "type": "finish",
      "success": true,
      "title": "EffectCraft installed",
      "button": "Close",
      "mark": "installed",
      "message": [
        "EffectCraft ${installed_version} is installed.",
        "",
        "Open it from your applications menu, or run “effectcraft” from a terminal.",
        "",
        "Installed as: ${method_label}"
      ]
    },
    "install_failed": {
      "type": "dialog",
      "title": "The installation did not finish",
      "tone": "error",
      "message": [
        "Something went wrong (step: ${last_failed}). Use “Show details” to read the output.",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    },
    "error_generic": {
      "type": "dialog",
      "title": "A check failed",
      "tone": "error",
      "message": [
        "“${last_failed}” did not work (exit code ${last_exit_code}).",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    },
    "un_start": {
      "type": "dialog",
      "title": "Remove EffectCraft?",
      "tone": "warning",
      "message": [
        "This removes the effectcraft package (and dependencies nothing else needs).",
        "Your project files are not touched — only the app itself is removed."
      ],
      "buttons": [
        {
          "label": "Remove EffectCraft",
          "style": "danger",
          "goto": "un_run"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "un_run": {
      "type": "run",
      "title": "Removing EffectCraft…",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Removing the package (admin password required)",
          "script": "removing-effectcraft.sh",
          "root": true,
          "percent": 100
        }
      ],
      "on_success": "un_done",
      "on_failure": "un_failed"
    },
    "un_done": {
      "type": "finish",
      "success": true,
      "mark": "uninstalled",
      "title": "EffectCraft removed",
      "message": "EffectCraft was removed from your computer."
    },
    "un_failed": {
      "type": "dialog",
      "title": "EffectCraft could not be removed",
      "tone": "error",
      "message": [
        "Step: ${last_failed}. Use “Show details” to read the output.",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    }
  }
}