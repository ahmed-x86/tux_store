{
  "schema": 2,
  "id": "winrar-wine-id-1",
  "title": "Install WinRAR (Wine)",
  "description": "Downloads the official WinRAR installer from rarlab.com and installs it silently inside Wine. Can be removed again with WinRAR's own uninstaller or the Wine uninstaller window.",
  "version": {
    "label": "Latest WinRAR version",
    "script": "latest-winrar-version.sh"
  },
  "author": "Tux Store",
  "keywords": [
    "winrar",
    "rar",
    "zip",
    "7z",
    "archive",
    "archiver",
    "compress",
    "extract",
    "wine",
    "ضغط",
    "فك الضغط",
    "وينرار",
    "ملفات مضغوطة",
    "برنامج"
  ],
  "show_on_home": true,
  "vars": {
    "wine_prefix": "",
    "winrar_code": "",
    "winrar_pretty": "",
    "preflight_err": "",
    "existing": "no",
    "lang_code": "en",
    "verify_msg": "",
    "un_mode": "auto"
  },
  "info": {
    "download_mb": 4,
    "extracted_mb": 10,
    "installed_mb": 12,
    "note": "WinRAR is installed inside your Wine prefix (WINEPREFIX, or ~/.wine by default). No administrator password is needed. WinRAR is shareware from rarlab.com; Tux Store only downloads the official installer."
  },
  "icon": [
    {
      "theme": "winrar"
    },
    {
      "file": "winrar-wine-id-1.png"
    }
  ],
  "start": "welcome",
  "uninstall": "un_start",
  "steps": {
    "welcome": {
      "type": "dialog",
      "title": "Install WinRAR",
      "tone": "info",
      "message": [
        "This guide installs WinRAR through Wine.",
        "",
        "It checks Wine, finds the latest version on the official site (rarlab.com), downloads the installer and runs it silently. No administrator password is needed."
      ],
      "buttons": [
        {
          "label": "Continue",
          "style": "primary",
          "goto": "preflight"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "preflight": {
      "type": "check",
      "command": {
        "label": "Checking your system…",
        "timeout_secs": 30,
        "script": "checking-your-system.sh"
      },
      "capture": "preflight_err",
      "on_success": "preflight_gate",
      "on_failure": "error_generic"
    },
    "preflight_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "preflight_err",
            "ne": ""
          },
          "goto": "preflight_failed"
        }
      ],
      "default": "find_prefix"
    },
    "preflight_failed": {
      "type": "dialog",
      "title": "Not ready yet",
      "tone": "warning",
      "message": "${preflight_err}",
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    },
    "find_prefix": {
      "type": "check",
      "command": {
        "label": "Looking for your Wine prefix…",
        "script": "looking-for-your-wine-prefix.sh"
      },
      "capture": "wine_prefix",
      "on_success": "find_version",
      "on_failure": "error_generic"
    },
    "find_version": {
      "type": "check",
      "command": {
        "label": "Looking for the latest WinRAR version…",
        "timeout_secs": 30,
        "script": "looking-for-the-latest-winrar-version.sh"
      },
      "capture": "winrar_code",
      "on_success": "pretty_version",
      "on_failure": "error_generic"
    },
    "pretty_version": {
      "type": "check",
      "command": {
        "label": "Reading the version…",
        "script": "reading-the-version.sh"
      },
      "capture": "winrar_pretty",
      "on_success": "choose_lang",
      "on_failure": "error_generic"
    },
    "choose_lang": {
      "type": "choice",
      "title": "Choose the language",
      "message": "WinRAR ${winrar_pretty} will be downloaded from the official site (rarlab.com).",
      "store_as": "lang_code",
      "default": "en",
      "next": "probe_existing",
      "continue_label": "Continue",
      "options": [
        {
          "value": "en",
          "label": "English",
          "hint": "The standard installer."
        },
        {
          "value": "ar",
          "label": "العربية (Arabic)",
          "hint": "The official Arabic version of WinRAR."
        }
      ],
      "buttons": [
        {
          "label": "Back",
          "goto": "welcome"
        }
      ]
    },
    "probe_existing": {
      "type": "check",
      "command": {
        "label": "Checking for an existing WinRAR…",
        "script": "checking-for-an-existing-winrar.sh"
      },
      "capture": "existing",
      "on_success": "existing_gate",
      "on_failure": "error_generic"
    },
    "existing_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "existing",
            "eq": "yes"
          },
          "goto": "already_there"
        }
      ],
      "default": "confirm"
    },
    "already_there": {
      "type": "dialog",
      "title": "WinRAR is already in this Wine prefix",
      "tone": "warning",
      "message": [
        "A WinRAR installation was found in:",
        "${wine_prefix}",
        "",
        "You can install it again over the existing one (your settings are kept), or close this guide."
      ],
      "buttons": [
        {
          "label": "Reinstall",
          "style": "primary",
          "goto": "confirm"
        },
        {
          "label": "Close",
          "exit": true
        }
      ]
    },
    "confirm": {
      "type": "dialog",
      "title": "Ready to install",
      "tone": "info",
      "message": [
        "WinRAR ${winrar_pretty} (64-bit, language: ${lang_code}) will be installed.",
        "",
        "Wine prefix: ${wine_prefix}",
        "Download: about 4 MB from www.rarlab.com",
        "",
        "If the Wine prefix does not exist yet it will be created first (this can take a minute).",
        "",
        "Do you want to continue?"
      ],
      "buttons": [
        {
          "label": "Install",
          "style": "primary",
          "goto": "install"
        },
        {
          "label": "Back",
          "goto": "choose_lang"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "install": {
      "type": "run",
      "title": "Installing WinRAR…",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Downloading WinRAR ${winrar_pretty}",
          "weight": 3,
          "expected_secs": 15,
          "percent": 30,
          "script": "downloading-winrar-winrar-pretty.sh"
        },
        {
          "label": "Preparing the Wine prefix",
          "weight": 4,
          "expected_secs": 30,
          "percent": 50,
          "timeout_secs": 300,
          "script": "preparing-the-wine-prefix.sh"
        },
        {
          "label": "Installing WinRAR in Wine",
          "weight": 6,
          "expected_secs": 25,
          "percent": 90,
          "timeout_secs": 600,
          "script": "installing-winrar-in-wine.sh"
        },
        {
          "label": "Removing the downloaded installer",
          "ignore_failure": true,
          "percent": 95,
          "script": "removing-the-downloaded-installer.sh"
        }
      ],
      "on_success": "verify",
      "on_failure": "install_failed"
    },
    "verify": {
      "type": "check",
      "command": {
        "label": "Checking the result…",
        "script": "checking-the-result.sh"
      },
      "capture": "verify_msg",
      "on_success": "set_version",
      "on_failure": "install_failed"
    },
    "set_version": {
      "type": "set",
      "vars": {
        "installed_version": "${winrar_pretty}"
      },
      "next": "record_install"
    },
    "record_install": {
      "type": "record",
      "set": {
        "winrar_prefix": "${wine_prefix}",
        "winrar_language": "${lang_code}"
      },
      "files": [
        "~/.local/share/applications/wine/Programs/WinRAR"
      ],
      "next": "done"
    },
    "done": {
      "type": "finish",
      "success": true,
      "title": "WinRAR installed",
      "button": "Close",
      "message": [
        "WinRAR ${winrar_pretty} was installed in Wine.",
        "",
        "Find it in your application menu, or right-click an archive and open it with WinRAR.",
        "Install folder: ${wine_prefix}/drive_c/Program Files/WinRAR"
      ],
      "mark": "installed"
    },
    "install_failed": {
      "type": "dialog",
      "title": "The installation did not finish",
      "tone": "error",
      "message": [
        "Something went wrong (step: ${last_failed}). Use “Show details” to read the output.",
        "",
        "${verify_msg}",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    },
    "error_generic": {
      "type": "dialog",
      "title": "A check failed",
      "tone": "error",
      "message": [
        "“${last_failed}” did not work (exit code ${last_exit_code}).",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    },
    "un_start": {
      "type": "check",
      "command": {
        "label": "Looking for Wine…",
        "script": "looking-for-wine.sh"
      },
      "on_success": "un_probe",
      "on_failure": "un_no_wine"
    },
    "un_no_wine": {
      "type": "dialog",
      "title": "Wine was not found",
      "tone": "warning",
      "message": [
        "Wine is not installed any more, so WinRAR's own uninstaller cannot run.",
        "",
        "I can still delete the WinRAR folder, its menu entries and shortcuts."
      ],
      "buttons": [
        {
          "label": "Delete the files",
          "style": "danger",
          "goto": "un_cleanup"
        },
        {
          "label": "Close",
          "exit": true
        }
      ]
    },
    "un_probe": {
      "type": "check",
      "command": {
        "label": "Looking for WinRAR…",
        "script": "looking-for-winrar.sh"
      },
      "capture": "un_present",
      "on_success": "un_probe_gate",
      "on_failure": "error_generic"
    },
    "un_probe_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "un_present",
            "eq": "no"
          },
          "goto": "un_cleanup"
        }
      ],
      "default": "un_choose"
    },
    "un_choose": {
      "type": "choice",
      "title": "How do you want to remove WinRAR?",
      "message": "Wine prefix: ${winrar_prefix}",
      "store_as": "un_mode",
      "default": "auto",
      "next": "un_confirm",
      "continue_label": "Continue",
      "options": [
        {
          "value": "auto",
          "label": "Automatic (recommended)",
          "hint": "Runs WinRAR's own uninstall.exe silently inside Wine, then cleans up the leftovers."
        },
        {
          "value": "gui",
          "label": "Wine uninstaller window",
          "hint": "Opens the Wine “Add/Remove Programs” window (wine uninstaller). Pick WinRAR in the list, press Remove, then close the window."
        }
      ],
      "buttons": [
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "un_confirm": {
      "type": "dialog",
      "title": "Remove WinRAR?",
      "tone": "warning",
      "message": [
        "WinRAR will be removed from this Wine prefix:",
        "${winrar_prefix}",
        "",
        "Its menu entries, shortcuts, file-association launchers and registry keys are cleaned up too. Other Wine programs are not touched."
      ],
      "buttons": [
        {
          "label": "Remove",
          "style": "danger",
          "goto": "un_mode_gate"
        },
        {
          "label": "Back",
          "goto": "un_choose"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "un_mode_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "un_mode",
            "eq": "gui"
          },
          "goto": "un_run_gui"
        }
      ],
      "default": "un_run_auto"
    },
    "un_run_auto": {
      "type": "run",
      "title": "Removing WinRAR…",
      "message": "Running the WinRAR uninstaller. Please wait.",
      "commands": [
        {
          "label": "Running WinRAR's uninstaller",
          "expected_secs": 15,
          "percent": 60,
          "timeout_secs": 300,
          "script": "running-winrar-s-uninstaller.sh"
        }
      ],
      "on_success": "un_verify",
      "on_failure": "un_failed"
    },
    "un_run_gui": {
      "type": "run",
      "title": "Wine uninstaller is open",
      "message": [
        "A window named “Wine Uninstaller” opens.",
        "Select WinRAR, press Remove, and when it is done close the window.",
        "This screen continues by itself when you close it."
      ],
      "commands": [
        {
          "label": "Waiting for the Wine uninstaller window",
          "percent": 60,
          "expected_secs": 60,
          "timeout_secs": 3600,
          "script": "waiting-for-the-wine-uninstaller-window.sh"
        }
      ],
      "on_success": "un_verify",
      "on_failure": "un_failed"
    },
    "un_verify": {
      "type": "check",
      "command": {
        "label": "Checking that WinRAR is gone…",
        "script": "checking-that-winrar-is-gone.sh"
      },
      "on_success": "un_cleanup",
      "on_failure": "un_still"
    },
    "un_still": {
      "type": "dialog",
      "title": "WinRAR is still installed",
      "tone": "warning",
      "message": [
        "WinRAR.exe is still in the Wine prefix. The uninstaller may have failed, or the window was closed before removing it.",
        "",
        "You can try again, or delete WinRAR's files directly."
      ],
      "buttons": [
        {
          "label": "Try again",
          "style": "primary",
          "goto": "un_choose"
        },
        {
          "label": "Delete its files anyway",
          "style": "danger",
          "goto": "un_cleanup"
        },
        {
          "label": "Close",
          "exit": true
        }
      ]
    },
    "un_cleanup": {
      "type": "run",
      "title": "Cleaning up…",
      "message": "Removing leftovers. Please wait.",
      "commands": [
        {
          "label": "Removing leftover files and shortcuts",
          "percent": 70,
          "script": "removing-leftover-files-and-shortcuts.sh"
        },
        {
          "label": "Cleaning Wine registry entries",
          "ignore_failure": true,
          "percent": 95,
          "timeout_secs": 120,
          "script": "cleaning-wine-registry-entries.sh"
        }
      ],
      "on_success": "un_done",
      "on_failure": "un_failed"
    },
    "un_done": {
      "type": "finish",
      "title": "WinRAR removed",
      "success": true,
      "button": "Close",
      "mark": "uninstalled",
      "message": "WinRAR, its shortcuts and its registry entries were removed. Your Wine prefix and other Wine programs were not touched."
    },
    "un_failed": {
      "type": "dialog",
      "title": "WinRAR could not be removed",
      "tone": "error",
      "message": [
        "Step: ${last_failed}. Use “Show details” to read the output.",
        "",
        "${last_output}",
        "",
        "The install record is kept, so you can try again."
      ],
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    }
  }
}
