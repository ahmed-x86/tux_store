{
  "schema": 2,
  "id": "ventoy-installer-id-1",
  "title": "Install Ventoy",
  "description": "Guided installation of the latest Ventoy bootable USB creator tool with full uninstall support.",
  "version": {
    "label": "Latest Ventoy version",
    "shell": [
      "latest_url=$(curl -sI https://github.com/ventoy/Ventoy/releases/latest | grep -i '^location:' | tr -d '\\r' | awk '{print $2}')",
      "basename \"${latest_url:-unknown}\""
    ]
  },
  "author": "Tux Store",
  "keywords": [
    "ventoy",
    "usb",
    "bootable",
    "iso",
    "ventoy-installer",
    "أداة",
    "حرق",
    "فلاشة"
  ],
  "show_on_home": true,
  "vars": {
    "ventoy_version": "unknown"
  },
  "start": "welcome",
  "steps": {
    "welcome": {
      "type": "dialog",
      "title": "Before you install Ventoy",
      "tone": "info",
      "message": [
        "This guide will automatically fetch the latest version of Ventoy from GitHub,",
        "extract it safely into your user space, and create a desktop shortcut for easy access."
      ],
      "buttons": [
        {
          "label": "Continue",
          "style": "primary",
          "goto": "preflight"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "preflight": {
      "type": "check",
      "command": {
        "label": "Checking system tools and internet…",
        "shell": [
          "for t in curl tar awk grep sed; do",
          "  command -v \"$t\" >/dev/null 2>&1 || { echo \"Required tool '$t' is missing.\"; exit 0; }",
          "done",
          "curl -fsI --max-time 10 https://github.com >/dev/null 2>&1 || { echo \"No internet connection to GitHub.\"; exit 0; }",
          "echo \"\""
        ]
      },
      "capture": "preflight_err",
      "on_success": "preflight_result",
      "on_failure": "error_generic"
    },
    "preflight_result": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "preflight_err",
            "ne": ""
          },
          "goto": "preflight_failed"
        }
      ],
      "default": "fetch_latest_version"
    },
    "preflight_failed": {
      "type": "dialog",
      "title": "Prerequisites check failed",
      "tone": "error",
      "message": "${preflight_err}",
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    },
    "fetch_latest_version": {
      "type": "check",
      "command": {
        "label": "Fetching latest version from GitHub…",
        "shell": [
          "l_url=$(curl -sI https://github.com/ventoy/Ventoy/releases/latest | grep -i '^location:' | tr -d '\\r' | awk '{print $2}')",
          "v_tag=$(basename \"$l_url\")",
          "[ -n \"$v_tag\" ] || { echo \"Failed to fetch version tag.\"; exit 1; }",
          "echo \"$v_tag\""
        ]
      },
      "capture": "ventoy_version",
      "on_success": "confirm_install",
      "on_failure": "error_generic"
    },
    "confirm_install": {
      "type": "dialog",
      "title": "Ready to install",
      "tone": "info",
      "message": [
        "Latest version detected: ${ventoy_version}",
        "",
        "Target directory: ~/.local/share/ventoy",
        "",
        "Do you want to proceed with the download and installation?"
      ],
      "buttons": [
        {
          "label": "Install",
          "style": "primary",
          "goto": "install_ventoy"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "install_ventoy": {
      "type": "run",
      "title": "Installing Ventoy…",
      "message": "Please wait while downloading and setting up Ventoy.",
      "commands": [
        {
          "label": "Downloading and extracting Ventoy",
          "shell": [
            "set -e",
            "v=\"$TUX_VAR_VENTOY_VERSION\"",
            "v_clean=$(echo \"$v\" | sed 's/^v//')",
            "tarball=\"ventoy-${v_clean}-linux.tar.gz\"",
            "dl_url=\"https://github.com/ventoy/Ventoy/releases/download/${v}/${tarball}\"",
            "",
            "tmp_dir=$(mktemp -d)",
            "cd \"$tmp_dir\"",
            "",
            "echo \"Downloading $tarball...\"",
            "curl -fL -o \"$tarball\" \"$dl_url\"",
            "",
            "echo \"Extracting files...\"",
            "tar -xzf \"$tarball\"",
            "",
            "dest=\"$HOME/.local/share/ventoy\"",
            "mkdir -p \"$dest\"",
            "rm -rf \"$dest\"/*",
            "",
            "extracted_folder=$(ls -d ventoy-*/)",
            "mv ${extracted_folder}* \"$dest/\"",
            "",
            "rm -rf \"$tmp_dir\""
          ],
          "weight": 10,
          "expected_secs": 60,
          "percent": 80
        },
        {
          "label": "Creating desktop shortcut",
          "shell": [
            "set -e",
            "dest=\"$HOME/.local/share/ventoy\"",
            "app_dir=\"$HOME/.local/share/applications\"",
            "mkdir -p \"$app_dir\"",
            "desktop_file=\"$app_dir/ventoy.desktop\"",
            "",
            "cat << EOF > \"$desktop_file\"",
            "[Desktop Entry]",
            "Name=Ventoy",
            "Comment=Create bootable USB easily",
            "Exec=pkexec env DISPLAY=$DISPLAY XAUTHORITY=$XAUTHORITY $dest/VentoyGUI.x86_64",
            "Path=$dest",
            "Icon=$dest/document/ventoy.png",
            "Terminal=false",
            "Type=Application",
            "Categories=System;Utility;",
            "EOF",
            "",
            "chmod +x \"$desktop_file\""
          ],
          "weight": 2,
          "expected_secs": 10,
          "percent": 95
        }
      ],
      "on_success": "remember_files",
      "on_failure": "install_failed"
    },
    "remember_files": {
      "type": "record",
      "files": [
        "~/.local/share/ventoy",
        "~/.local/share/applications/ventoy.desktop"
      ],
      "next": "done_install"
    },
    "done_install": {
      "type": "finish",
      "success": true,
      "title": "Installation Complete",
      "button": "Close",
      "message": [
        "Ventoy has been successfully installed.",
        "",
        "A desktop shortcut has been created in your applications menu with the correct working path and architecture binary."
      ],
      "mark": "installed"
    },
    "un_confirm": {
      "type": "dialog",
      "title": "Remove Ventoy?",
      "message": "This deletes the recorded files and shortcuts:\n${recorded_files}",
      "buttons": [
        {
          "label": "Remove",
          "style": "danger",
          "goto": "un_run"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "un_run": {
      "type": "run",
      "title": "Removing Ventoy…",
      "message": "Please wait while cleaning up files.",
      "commands": [
        {
          "label": "Deleting the recorded files and shortcuts",
          "percent": 100,
          "shell": [
            "printf '%s\\n' \"$TUX_VAR_RECORDED_FILES\" | while IFS= read -r f; do",
            "  case \"$f\" in \"$HOME\"/*) rm -rf -- \"$f\"; echo \"removed $f\" ;; *) echo \"skipped $f\" ;; esac",
            "done"
          ]
        }
      ],
      "on_success": "un_done"
    },
    "un_done": {
      "type": "finish",
      "title": "Uninstalled",
      "success": true,
      "mark": "uninstalled",
      "message": "Ventoy and its shortcuts were successfully removed from your system."
    },
    "install_failed": {
      "type": "dialog",
      "title": "Installation Failed",
      "tone": "error",
      "message": [
        "Something went wrong during the installation process (step: ${last_failed}).",
        "Check details for more info."
      ],
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    },
    "error_generic": {
      "type": "dialog",
      "title": "Error",
      "tone": "error",
      "message": [
        "An error occurred: “${last_failed}” (exit code ${last_exit_code}).",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    }
  },
  "info": {
    "download_mb": 15,
    "extracted_mb": 50,
    "installed_mb": 50,
    "note": "Ventoy allows you to create a bootable USB stick for ISO/WIM/IMG/VHD(x)/EFI files easily without formatting the disk repeatedly."
  },
  "icon": [
    {
      "theme": "ventoy"
    },
    {
      "url": "https://raw.githubusercontent.com/ventoy/Ventoy/master/DOC/image/ventoy_small.png"
    }
  ],
  "uninstall": "un_confirm"
}