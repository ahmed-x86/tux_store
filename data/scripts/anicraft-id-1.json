{
  "schema": 2,
  "id": "anicraft-id-1",
  "title": "Install AniCraft",
  "description": "AniCraft is an open-source 2D vector animation app — a Flash/Animate-style tool. This downloads the latest Linux AppImage from GitHub, You choose how to install it: wrap the official AppImage into a local pacman package (icon + desktop entry + a anicraft command), or install the official native Arch package (.pkg.tar.zst) directly. The latest version is detected automatically.",
  "version": {
    "label": "Latest AniCraft version",
    "script": "latest-version.sh"
  },
  "author": "Tux Store Team",
  "keywords": [
    "anicraft",
    "artcraft",
    "ارت كرافت",
    "برامج كرافت",
    "إيني كرافت",
    "craft apps",
    "2d animation",
    "animation",
    "vector animation",
    "animate",
    "tweening",
    "appimage",
    "رسوم متحركة",
    "انيميشن",
    "تحريك ثنائي الأبعاد",
    "flash",
    "adobe animate",
    "cartoon",
    "sprite",
    "2d",
    "vector graphics",
    "رسوم",
    "كارتون",
    "أنيمي",
    "تحريك رسوم",
    "أدوبي أنيميت"
  ],
  "show_on_home": false,
  "categories": [
    "artcraft",
    "graphics"
  ],
  "info": {
    "download_mb": 19,
    "installed_mb": 20,
    "extracted_mb": 0,
    "note": "Sizes are for the AppImage method; the native package may differ slightly. AniCraft's release size may change over time."
  },
  "icon": [
    {
      "file": "anicraft-id-1.png"
    }
  ],
  "vars": {
    "preflight": "",
    "latest_version": "",
    "installed_version": "",
    "method": "appimage",
    "method_label": "",
    "native_pkg": ""
  },
  "start": "welcome",
  "uninstall": "un_start",
  "steps": {
    "welcome": {
      "type": "dialog",
      "title": "Install AniCraft",
      "tone": "info",
      "message": [
        "AniCraft is part of the ArtCraft suite — an open-source 2D vector animation app — a Flash/Animate-style tool.",
        "",
        "On the next screen you choose how to install it: wrap the official AppImage into a local pacman package, or install the official native Arch package directly.",
        "",
        "Either way you get the official release from GitHub — nothing inside AniCraft is modified."
      ],
      "buttons": [
        {
          "label": "Continue",
          "style": "primary",
          "goto": "choose_method"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "choose_method": {
      "type": "choice",
      "title": "Choose the installation method",
      "store_as": "method",
      "default": "appimage",
      "next": "preflight",
      "continue_label": "Continue",
      "options": [
        {
          "value": "appimage",
          "label": "AppImage, wrapped as a pacman package",
          "hint": "Downloads the official AppImage and packages it locally with makepkg (icon, menu entry and a command). Needs base-devel and fuse2.",
          "set": {
            "method_label": "AppImage wrapped as a pacman package"
          }
        },
        {
          "value": "native",
          "label": "Native Arch package",
          "hint": "Downloads the official ready-made .pkg.tar.zst from GitHub and installs it directly with pacman. No local build; dependencies come from your repositories.",
          "set": {
            "method_label": "Native Arch package (.pkg.tar.zst)"
          }
        }
      ],
      "buttons": [
        {
          "label": "Back",
          "goto": "welcome"
        }
      ]
    },
    "preflight": {
      "type": "check",
      "command": {
        "label": "Checking your system…",
        "script": "checking-requirements.sh"
      },
      "capture": "preflight",
      "on_success": "preflight_result",
      "on_failure": "error_generic"
    },
    "preflight_result": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "preflight",
            "ne": ""
          },
          "goto": "preflight_failed"
        }
      ],
      "default": "detect_version"
    },
    "preflight_failed": {
      "type": "dialog",
      "title": "Not ready yet",
      "tone": "warning",
      "message": "${preflight}",
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    },
    "detect_version": {
      "type": "check",
      "command": {
        "label": "Checking the latest AniCraft version…",
        "script": "latest-version.sh"
      },
      "capture": "latest_version",
      "on_success": "confirm",
      "on_failure": "error_generic"
    },
    "confirm": {
      "type": "dialog",
      "title": "Install AniCraft ${latest_version}",
      "tone": "info",
      "message": [
        "Ready to install AniCraft ${latest_version}.",
        "",
        "Method: ${method_label}",
        "",
        "You will be asked for your password once to install the package."
      ],
      "buttons": [
        {
          "label": "Install",
          "style": "primary",
          "goto": "route"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "route": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "method",
            "eq": "native"
          },
          "goto": "native_download_step"
        }
      ],
      "default": "download_step"
    },
    "download_step": {
      "type": "run",
      "title": "Downloading AniCraft…",
      "message": "Please wait.",
      "commands": [
        {
          "label": "Downloading the AppImage",
          "script": "download-appimage.sh",
          "progress": "percent",
          "percent": 40,
          "expected_secs": 60
        }
      ],
      "on_success": "build_step",
      "on_failure": "install_failed"
    },
    "build_step": {
      "type": "run",
      "title": "Packaging AniCraft…",
      "message": "Building a pacman package from the AppImage.",
      "commands": [
        {
          "label": "Building the package",
          "script": "build-package.sh",
          "percent": 70,
          "expected_secs": 30
        }
      ],
      "on_success": "install_step",
      "on_failure": "install_failed"
    },
    "install_step": {
      "type": "run",
      "title": "Installing AniCraft…",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Installing the package (admin password required)",
          "script": "install-package.sh",
          "root": true,
          "percent": 95
        },
        {
          "label": "Cleaning up temporary files",
          "script": "cleanup-after-install.sh",
          "ignore_failure": true,
          "percent": 100
        }
      ],
      "on_success": "verify",
      "on_failure": "install_failed"
    },
    "native_download_step": {
      "type": "run",
      "title": "Downloading AniCraft…",
      "message": "Downloading the official Arch package.",
      "commands": [
        {
          "label": "Downloading the native package",
          "script": "download-native.sh",
          "progress": "percent",
          "percent": 70,
          "expected_secs": 40
        }
      ],
      "on_success": "native_name_step",
      "on_failure": "install_failed"
    },
    "native_name_step": {
      "type": "check",
      "command": {
        "label": "Reading the package info…",
        "script": "reading-native-package-name.sh"
      },
      "capture": "native_pkg",
      "on_success": "native_install_step",
      "on_failure": "install_failed"
    },
    "native_install_step": {
      "type": "run",
      "title": "Installing AniCraft…",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Installing the package (admin password required)",
          "script": "install-native-package.sh",
          "root": true,
          "percent": 95
        },
        {
          "label": "Cleaning up temporary files",
          "script": "cleanup-after-install.sh",
          "ignore_failure": true,
          "percent": 100
        }
      ],
      "on_success": "verify",
      "on_failure": "install_failed"
    },
    "verify": {
      "type": "check",
      "command": {
        "label": "Verifying the installation…",
        "script": "reading-installed-version.sh"
      },
      "capture": "installed_version",
      "on_success": "verify_result",
      "on_failure": "install_failed"
    },
    "verify_result": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "installed_version",
            "eq": ""
          },
          "goto": "install_failed"
        },
        {
          "when": {
            "var": "method",
            "eq": "native"
          },
          "goto": "record_install_native"
        }
      ],
      "default": "record_install"
    },
    "record_install": {
      "type": "record",
      "set": {
        "installed_version": "${installed_version}"
      },
      "packages": [
        "anicraft"
      ],
      "next": "done"
    },
    "record_install_native": {
      "type": "record",
      "set": {
        "installed_version": "${installed_version}"
      },
      "packages": [
        "${native_pkg}"
      ],
      "next": "done"
    },
    "done": {
      "type": "finish",
      "success": true,
      "title": "AniCraft installed",
      "button": "Close",
      "mark": "installed",
      "message": [
        "AniCraft ${installed_version} is installed.",
        "",
        "Open it from your applications menu, or run “anicraft” from a terminal.",
        "",
        "Installed as: ${method_label}"
      ]
    },
    "install_failed": {
      "type": "dialog",
      "title": "The installation did not finish",
      "tone": "error",
      "message": [
        "Something went wrong (step: ${last_failed}). Use “Show details” to read the output.",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    },
    "error_generic": {
      "type": "dialog",
      "title": "A check failed",
      "tone": "error",
      "message": [
        "“${last_failed}” did not work (exit code ${last_exit_code}).",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    },
    "un_start": {
      "type": "dialog",
      "title": "Remove AniCraft?",
      "tone": "warning",
      "message": [
        "This removes the anicraft package (and dependencies nothing else needs).",
        "Your project files are not touched — only the app itself is removed."
      ],
      "buttons": [
        {
          "label": "Remove AniCraft",
          "style": "danger",
          "goto": "un_run"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "un_run": {
      "type": "run",
      "title": "Removing AniCraft…",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Removing the package (admin password required)",
          "script": "removing-anicraft.sh",
          "root": true,
          "percent": 100
        }
      ],
      "on_success": "un_done",
      "on_failure": "un_failed"
    },
    "un_done": {
      "type": "finish",
      "success": true,
      "mark": "uninstalled",
      "title": "AniCraft removed",
      "message": "AniCraft was removed from your computer."
    },
    "un_failed": {
      "type": "dialog",
      "title": "AniCraft could not be removed",
      "tone": "error",
      "message": [
        "Step: ${last_failed}. Use “Show details” to read the output.",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "style": "primary",
          "exit": true
        }
      ]
    }
  }
}