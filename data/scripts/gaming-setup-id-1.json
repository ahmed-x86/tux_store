{
  "schema": 2,
  "id": "gaming-setup-id-1",
  "title": "Gaming setup",
  "description": "Steam plus optional performance tools (GameMode and MangoHud). Needs the [multilib] repository enabled in /etc/pacman.conf.",
  "author": "Tux Store",
  "keywords": [
    "gaming",
    "game",
    "games",
    "steam",
    "gamemode",
    "mangohud",
    "proton",
    "lutris",
    "performance",
    "multilib",
    "ألعاب",
    "لعبة",
    "ستيم"
  ],
  "show_on_home": true,
  "category": "games",
  "vars": {
    "new_pkgs": "",
    "skipped_pkgs": "",
    "skipped_text": "",
    "preflight": "",
    "verify_msg": "",
    "profile": "steam",
    "pkgs": "steam"
  },
  "info": {
    "download_mb": {
      "label": "Download size (Steam only)",
      "script": "download-size-steam-only.sh"
    },
    "installed_mb": {
      "label": "Installed size (Steam only)",
      "script": "installed-size-steam-only.sh"
    },
    "extracted_mb": 20,
    "note": "Sizes are for Steam only, read from your package database. The performance set adds a little more. Packages you already have are skipped."
  },
  "icon": [
    {
      "file": "gaming-setup-id-1.svg"
    }
  ],
  "start": "welcome",
  "uninstall": "un_start",
  "steps": {
    "welcome": {
      "type": "dialog",
      "title": "Gaming setup",
      "tone": "info",
      "message": [
        "Play games on Linux.",
        "",
        "Steam comes from the [multilib] repository, so it must be enabled in /etc/pacman.conf. If it is not, this add-on stops and tells you.",
        "Steam also needs a 32-bit Vulkan driver; if none is installed, the one matching your graphics card is added first.",
        "The performance set adds GameMode (CPU/GPU tuning while a game runs) and MangoHud (an FPS overlay)."
      ],
      "buttons": [
        {
          "label": "Continue",
          "style": "primary",
          "goto": "choose"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "choose": {
      "type": "choice",
      "title": "What do you want to install?",
      "message": "You can run this again later to add more.",
      "store_as": "profile",
      "default": "steam",
      "next": "preflight",
      "continue_label": "Continue",
      "options": [
        {
          "value": "steam",
          "label": "Steam only",
          "hint": [
            "Just the Steam client."
          ],
          "set": {
            "pkgs": "steam"
          }
        },
        {
          "value": "perf",
          "label": "Steam + GameMode + MangoHud",
          "hint": [
            "Adds performance tools (32-bit and 64-bit libraries)."
          ],
          "set": {
            "pkgs": "steam gamemode lib32-gamemode mangohud lib32-mangohud"
          }
        }
      ],
      "buttons": [
        {
          "label": "Back",
          "goto": "welcome"
        }
      ]
    },
    "preflight": {
      "type": "check",
      "command": {
        "label": "Checking your system…",
        "script": "checking-your-system.sh"
      },
      "capture": "preflight",
      "on_success": "preflight_gate",
      "on_failure": "error_generic"
    },
    "preflight_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "preflight",
            "ne": ""
          },
          "goto": "problem"
        }
      ],
      "default": "find_missing"
    },
    "problem": {
      "type": "dialog",
      "title": "Cannot continue",
      "tone": "error",
      "message": "${preflight}",
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    },
    "find_missing": {
      "type": "check",
      "command": {
        "label": "Looking at what is already installed…",
        "timeout_secs": 60,
        "script": "looking-at-what-is-already-installed.sh"
      },
      "capture": "new_pkgs",
      "on_success": "find_skipped",
      "on_failure": "error_generic"
    },
    "find_skipped": {
      "type": "check",
      "command": {
        "label": "Checking the repositories…",
        "timeout_secs": 60,
        "script": "checking-the-repositories.sh"
      },
      "capture": "skipped_pkgs",
      "on_success": "missing_gate",
      "on_failure": "error_generic"
    },
    "missing_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "new_pkgs",
            "eq": ""
          },
          "goto": "already_done"
        },
        {
          "when": {
            "var": "skipped_pkgs",
            "ne": ""
          },
          "goto": "skipped_line"
        }
      ],
      "default": "confirm"
    },
    "skipped_line": {
      "type": "set",
      "vars": {
        "skipped_text": "Not in your repositories (skipped): ${skipped_pkgs}"
      },
      "next": "confirm"
    },
    "already_done": {
      "type": "finish",
      "title": "Already installed",
      "success": true,
      "mark": "installed",
      "button": "Close",
      "message": "Everything in this set is already on your system, so nothing was changed."
    },
    "confirm": {
      "type": "dialog",
      "title": "Ready to install",
      "tone": "info",
      "message": [
        "This will be installed:",
        "${new_pkgs}",
        "",
        "${skipped_text}",
        "",
        "You will be asked for your password."
      ],
      "buttons": [
        {
          "label": "Install",
          "style": "primary",
          "goto": "install"
        },
        {
          "label": "Back",
          "goto": "choose"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "install": {
      "type": "run",
      "title": "Setting up: Gaming setup",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Installing packages",
          "root": true,
          "weight": 10,
          "expected_secs": 60,
          "percent": 90,
          "script": "installing-packages.sh"
        }
      ],
      "on_success": "verify",
      "on_failure": "install_failed"
    },
    "verify": {
      "type": "check",
      "command": {
        "label": "Checking the result…",
        "timeout_secs": 60,
        "script": "checking-the-result.sh"
      },
      "capture": "verify_msg",
      "on_success": "record_install",
      "on_failure": "install_failed"
    },
    "record_install": {
      "type": "record",
      "set": {
        "installed_profile": "${profile}"
      },
      "packages": [
        "${new_pkgs}"
      ],
      "next": "done"
    },
    "done": {
      "type": "finish",
      "title": "Gaming tools installed",
      "success": true,
      "mark": "installed",
      "button": "Close",
      "message": [
        "Steam is installed.",
        "Start it once so it can update itself. For GameMode, set a game’s launch option to: gamemoderun %command%"
      ]
    },
    "install_failed": {
      "type": "dialog",
      "title": "Installation failed",
      "tone": "error",
      "message": [
        "${last_failed}",
        "${verify_msg}",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    },
    "error_generic": {
      "type": "dialog",
      "title": "Something went wrong",
      "tone": "error",
      "message": "The system check could not run. Please try again.",
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    },
    "un_start": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "recorded_packages",
            "eq": ""
          },
          "goto": "un_nothing"
        }
      ],
      "default": "un_confirm"
    },
    "un_nothing": {
      "type": "finish",
      "title": "Nothing to remove",
      "success": true,
      "mark": "uninstalled",
      "button": "Close",
      "message": [
        "These packages were already on your system before this add-on, so Tux Store keeps them.",
        "This add-on is now marked as not installed."
      ]
    },
    "un_confirm": {
      "type": "dialog",
      "title": "Remove Gaming setup?",
      "tone": "warning",
      "message": [
        "These packages were installed by this add-on and will be removed:",
        "${recorded_packages}",
        "",
        "A package that other software still needs is kept.",
        "",
        "You will be asked for your password."
      ],
      "buttons": [
        {
          "label": "Remove",
          "style": "danger",
          "goto": "un_preflight"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "un_preflight": {
      "type": "check",
      "command": {
        "label": "Checking your system…",
        "script": "checking-your-system-2.sh"
      },
      "capture": "preflight",
      "on_success": "un_gate",
      "on_failure": "error_generic"
    },
    "un_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "preflight",
            "ne": ""
          },
          "goto": "problem"
        }
      ],
      "default": "un_run"
    },
    "un_run": {
      "type": "run",
      "title": "Removing Gaming setup…",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Removing packages",
          "root": true,
          "expected_secs": 20,
          "percent": 95,
          "script": "removing-packages.sh"
        }
      ],
      "on_success": "un_done",
      "on_failure": "un_failed"
    },
    "un_done": {
      "type": "finish",
      "title": "Gaming tools removed",
      "success": true,
      "mark": "uninstalled",
      "button": "Close",
      "message": "The packages this add-on installed were removed. Packages that other software needs were kept. Your games and Steam data in your home folder are untouched."
    },
    "un_failed": {
      "type": "dialog",
      "title": "Removal failed",
      "tone": "error",
      "message": [
        "${last_failed}",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    }
  }
}
