{
  "schema": 2,
  "id": "yay-aur-helper-id-1",
  "title": "AUR helper (yay)",
  "description": "Build and install yay, a helper for the Arch User Repository. Needs base-devel and git, which are installed first.",
  "author": "Tux Store",
  "keywords": [
    "yay",
    "aur",
    "helper",
    "paru",
    "makepkg",
    "arch user repository",
    "aur helper",
    "ياي"
  ],
  "show_on_home": true,
  "vars": {
    "new_pkgs": "",
    "skipped_pkgs": "",
    "skipped_text": "",
    "preflight": "",
    "verify_msg": "",
    "profile": "basic",
    "pkgs": "base-devel git"
  },
  "info": {
    "download_mb": {
      "label": "Download size",
      "shell": "pacman -Si base-devel git 2>/dev/null | awk '/^Download Size/ {v=$4; u=$5; if (u==\"KiB\") v/=1024; else if (u==\"GiB\") v*=1024; else if (u==\"B\") v/=1048576; t+=v} END {printf \"%d\\n\", t+0.5}'"
    },
    "installed_mb": {
      "label": "Installed size",
      "shell": "pacman -Si base-devel git 2>/dev/null | awk '/^Installed Size/ {v=$4; u=$5; if (u==\"KiB\") v/=1024; else if (u==\"GiB\") v*=1024; else if (u==\"B\") v/=1048576; t+=v} END {printf \"%d\\n\", t+0.5}'"
    },
    "extracted_mb": 20,
    "note": "The build downloads about 20 MB of Go dependencies from the internet."
  },
  "icon": [
    {
      "file": "yay-aur-helper-id-1.svg"
    }
  ],
  "start": "welcome",
  "uninstall": "un_start",
  "steps": {
    "welcome": {
      "type": "dialog",
      "title": "AUR helper (yay)",
      "tone": "info",
      "message": [
        "yay lets you search and install packages from the AUR in the terminal.",
        "",
        "This installs base-devel and git, then downloads the yay recipe from aur.archlinux.org, builds it as your normal user and installs the result.",
        "AUR packages are made by users, not Arch. Read a recipe before you trust it."
      ],
      "buttons": [
        {
          "label": "Continue",
          "style": "primary",
          "goto": "preflight"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "preflight": {
      "type": "check",
      "command": {
        "label": "Checking your system…",
        "shell": [
          "[ \"$(id -u)\" -ne 0 ] || { echo \"Tux Store is running as root. Start it as a normal user; it asks for the password only when needed.\"; exit 0; }",
          "for t in pkexec pacman; do",
          "  command -v \"$t\" >/dev/null 2>&1 || { echo \"The required tool '$t' is missing.\"; exit 0; }",
          "done",
          "[ ! -e /var/lib/pacman/db.lck ] || { echo \"pacman is locked (/var/lib/pacman/db.lck exists). Another package manager may be running. Wait for it to finish, then try again.\"; exit 0; }",
          "echo \"\""
        ]
      },
      "capture": "preflight",
      "on_success": "preflight_gate",
      "on_failure": "error_generic"
    },
    "preflight_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "preflight",
            "ne": ""
          },
          "goto": "problem"
        }
      ],
      "default": "find_missing"
    },
    "problem": {
      "type": "dialog",
      "title": "Cannot continue",
      "tone": "error",
      "message": "${preflight}",
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    },
    "find_missing": {
      "type": "check",
      "command": {
        "label": "Looking at what is already installed…",
        "timeout_secs": 60,
        "shell": [
          "pacman -Qq yay >/dev/null 2>&1 || echo yay"
        ]
      },
      "capture": "new_pkgs",
      "on_success": "find_skipped",
      "on_failure": "error_generic"
    },
    "find_skipped": {
      "type": "check",
      "command": {
        "label": "Checking the repositories…",
        "timeout_secs": 60,
        "shell": [
          "echo \"\""
        ]
      },
      "capture": "skipped_pkgs",
      "on_success": "missing_gate",
      "on_failure": "error_generic"
    },
    "missing_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "new_pkgs",
            "eq": ""
          },
          "goto": "already_done"
        },
        {
          "when": {
            "var": "skipped_pkgs",
            "ne": ""
          },
          "goto": "skipped_line"
        }
      ],
      "default": "confirm"
    },
    "skipped_line": {
      "type": "set",
      "vars": {
        "skipped_text": "Not in your repositories (skipped): ${skipped_pkgs}"
      },
      "next": "confirm"
    },
    "already_done": {
      "type": "finish",
      "title": "Already installed",
      "success": true,
      "mark": "installed",
      "button": "Close",
      "message": [
        "yay is already installed."
      ]
    },
    "confirm": {
      "type": "dialog",
      "title": "Ready to install",
      "tone": "info",
      "message": [
        "This will:",
        "1. install base-devel and git (if missing),",
        "2. download the yay recipe from aur.archlinux.org and build it as your user,",
        "3. install the built package with pacman.",
        "",
        "You will be asked for your password for steps 1 and 3."
      ],
      "buttons": [
        {
          "label": "Install",
          "style": "primary",
          "goto": "install"
        },
        {
          "label": "Back",
          "goto": "welcome"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "install": {
      "type": "run",
      "title": "Setting up: AUR helper (yay)",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Installing build tools",
          "root": true,
          "weight": 3,
          "expected_secs": 40,
          "percent": 20,
          "shell": [
            "set -e",
            "pacman -S --needed --noconfirm base-devel git"
          ]
        },
        {
          "label": "Building yay (as your user)",
          "weight": 10,
          "expected_secs": 120,
          "percent": 75,
          "shell": [
            "set -e",
            "d=\"${XDG_CACHE_HOME:-$HOME/.cache}/tux-store/yay-build\"",
            "rm -rf \"$d\"; mkdir -p \"$d\"",
            "git clone --depth 1 https://aur.archlinux.org/yay.git \"$d/yay\"",
            "cd \"$d/yay\"",
            "makepkg -f --noconfirm",
            "echo \"$d/yay\" > \"$d/where\""
          ]
        },
        {
          "label": "Installing yay",
          "root": true,
          "expected_secs": 10,
          "percent": 98,
          "shell": [
            "set -e",
            "u=$(id -nu \"${PKEXEC_UID:-0}\")",
            "h=$(getent passwd \"$u\" | cut -d: -f6)",
            "pacman -U --noconfirm \"$h\"/.cache/tux-store/yay-build/yay/yay-*.pkg.tar.zst",
            "rm -rf \"$h/.cache/tux-store/yay-build\""
          ]
        }
      ],
      "on_success": "verify",
      "on_failure": "install_failed"
    },
    "verify": {
      "type": "check",
      "command": {
        "label": "Checking the result…",
        "timeout_secs": 60,
        "shell": [
          "bad=\"\"",
          "for p in $TUX_VAR_NEW_PKGS; do",
          "  pacman -Qq \"$p\" >/dev/null 2>&1 || bad=\"$bad $p\"",
          "done",
          "[ -z \"$bad\" ] || { echo \"Not installed:$bad\"; exit 1; }",
          "echo ok"
        ]
      },
      "capture": "verify_msg",
      "on_success": "record_install",
      "on_failure": "install_failed"
    },
    "record_install": {
      "type": "record",
      "set": {
        "installed_profile": "${profile}"
      },
      "packages": [
        "${new_pkgs}"
      ],
      "next": "done"
    },
    "done": {
      "type": "finish",
      "title": "yay installed",
      "success": true,
      "mark": "installed",
      "button": "Close",
      "message": [
        "yay is installed. Try it in a terminal: yay -Ss firefox"
      ]
    },
    "install_failed": {
      "type": "dialog",
      "title": "Installation failed",
      "tone": "error",
      "message": [
        "${last_failed}",
        "${verify_msg}",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    },
    "error_generic": {
      "type": "dialog",
      "title": "Something went wrong",
      "tone": "error",
      "message": "The system check could not run. Please try again.",
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    },
    "un_start": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "recorded_packages",
            "eq": ""
          },
          "goto": "un_nothing"
        }
      ],
      "default": "un_confirm"
    },
    "un_nothing": {
      "type": "finish",
      "title": "Nothing to remove",
      "success": true,
      "mark": "uninstalled",
      "button": "Close",
      "message": [
        "These codecs were already on your system before, so Tux Store keeps them.",
        "This add-on is now marked as not installed."
      ]
    },
    "un_confirm": {
      "type": "dialog",
      "title": "Remove AUR helper (yay)?",
      "tone": "warning",
      "message": [
        "yay will be removed. base-devel and git stay installed.",
        "",
        "You will be asked for your password."
      ],
      "buttons": [
        {
          "label": "Remove",
          "style": "danger",
          "goto": "un_preflight"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "un_preflight": {
      "type": "check",
      "command": {
        "label": "Checking your system…",
        "shell": [
          "[ \"$(id -u)\" -ne 0 ] || { echo \"Tux Store is running as root. Start it as a normal user; it asks for the password only when needed.\"; exit 0; }",
          "for t in pkexec pacman; do",
          "  command -v \"$t\" >/dev/null 2>&1 || { echo \"The required tool '$t' is missing.\"; exit 0; }",
          "done",
          "[ ! -e /var/lib/pacman/db.lck ] || { echo \"pacman is locked (/var/lib/pacman/db.lck exists). Another package manager may be running. Wait for it to finish, then try again.\"; exit 0; }",
          "echo \"\""
        ]
      },
      "capture": "preflight",
      "on_success": "un_gate",
      "on_failure": "error_generic"
    },
    "un_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "preflight",
            "ne": ""
          },
          "goto": "problem"
        }
      ],
      "default": "un_run"
    },
    "un_run": {
      "type": "run",
      "title": "Removing AUR helper (yay)…",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Removing the codec packages",
          "root": true,
          "expected_secs": 20,
          "percent": 95,
          "shell": [
            "# Two passes: a package may only become removable after another one is gone.",
            "for pass in 1 2; do",
            "  for p in $TUX_VAR_RECORDED_PACKAGES; do",
            "    pacman -Qq \"$p\" >/dev/null 2>&1 || continue",
            "    if pacman -Rns --noconfirm \"$p\" >/dev/null 2>&1; then echo \"removed $p\"; elif [ \"$pass\" = 2 ]; then echo \"kept $p (other software needs it)\"; fi",
            "  done",
            "done",
            "exit 0"
          ]
        }
      ],
      "on_success": "un_done",
      "on_failure": "un_failed"
    },
    "un_done": {
      "type": "finish",
      "title": "Codecs removed",
      "success": true,
      "mark": "uninstalled",
      "button": "Close",
      "message": "The packages this add-on installed were removed. Packages that other software needs were kept."
    },
    "un_failed": {
      "type": "dialog",
      "title": "Removal failed",
      "tone": "error",
      "message": [
        "${last_failed}",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    }
  }
}
