{
  "schema": 2,
  "id": "yay-aur-helper-id-1",
  "title": "AUR helper (yay)",
  "description": "Build and install yay, a helper for the Arch User Repository. Needs base-devel and git, which are installed first.",
  "author": "Tux Store",
  "keywords": [
    "yay",
    "aur",
    "helper",
    "paru",
    "makepkg",
    "arch user repository",
    "aur helper",
    "ياي"
  ],
  "show_on_home": true,
  "vars": {
    "new_pkgs": "",
    "skipped_pkgs": "",
    "skipped_text": "",
    "preflight": "",
    "verify_msg": "",
    "profile": "basic",
    "pkgs": "base-devel git"
  },
  "info": {
    "download_mb": {
      "label": "Download size",
      "script": "download-size.sh"
    },
    "installed_mb": {
      "label": "Installed size",
      "script": "installed-size.sh"
    },
    "extracted_mb": 20,
    "note": "The build downloads about 20 MB of Go dependencies from the internet."
  },
  "icon": [
    {
      "file": "yay-aur-helper-id-1.svg"
    }
  ],
  "start": "welcome",
  "uninstall": "un_start",
  "steps": {
    "welcome": {
      "type": "dialog",
      "title": "AUR helper (yay)",
      "tone": "info",
      "message": [
        "yay lets you search and install packages from the AUR in the terminal.",
        "",
        "This installs base-devel and git, then downloads the yay recipe from aur.archlinux.org, builds it as your normal user and installs the result.",
        "AUR packages are made by users, not Arch. Read a recipe before you trust it."
      ],
      "buttons": [
        {
          "label": "Continue",
          "style": "primary",
          "goto": "preflight"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "preflight": {
      "type": "check",
      "command": {
        "label": "Checking your system…",
        "script": "checking-your-system.sh"
      },
      "capture": "preflight",
      "on_success": "preflight_gate",
      "on_failure": "error_generic"
    },
    "preflight_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "preflight",
            "ne": ""
          },
          "goto": "problem"
        }
      ],
      "default": "find_missing"
    },
    "problem": {
      "type": "dialog",
      "title": "Cannot continue",
      "tone": "error",
      "message": "${preflight}",
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    },
    "find_missing": {
      "type": "check",
      "command": {
        "label": "Looking at what is already installed…",
        "timeout_secs": 60,
        "script": "looking-at-what-is-already-installed.sh"
      },
      "capture": "new_pkgs",
      "on_success": "find_skipped",
      "on_failure": "error_generic"
    },
    "find_skipped": {
      "type": "check",
      "command": {
        "label": "Checking the repositories…",
        "timeout_secs": 60,
        "script": "checking-the-repositories.sh"
      },
      "capture": "skipped_pkgs",
      "on_success": "missing_gate",
      "on_failure": "error_generic"
    },
    "missing_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "new_pkgs",
            "eq": ""
          },
          "goto": "already_done"
        },
        {
          "when": {
            "var": "skipped_pkgs",
            "ne": ""
          },
          "goto": "skipped_line"
        }
      ],
      "default": "confirm"
    },
    "skipped_line": {
      "type": "set",
      "vars": {
        "skipped_text": "Not in your repositories (skipped): ${skipped_pkgs}"
      },
      "next": "confirm"
    },
    "already_done": {
      "type": "finish",
      "title": "Already installed",
      "success": true,
      "mark": "installed",
      "button": "Close",
      "message": [
        "yay is already installed."
      ]
    },
    "confirm": {
      "type": "dialog",
      "title": "Ready to install",
      "tone": "info",
      "message": [
        "This will:",
        "1. install base-devel and git (if missing),",
        "2. download the yay recipe from aur.archlinux.org and build it as your user,",
        "3. install the built package with pacman.",
        "",
        "You will be asked for your password for steps 1 and 3."
      ],
      "buttons": [
        {
          "label": "Install",
          "style": "primary",
          "goto": "install"
        },
        {
          "label": "Back",
          "goto": "welcome"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "install": {
      "type": "run",
      "title": "Setting up: AUR helper (yay)",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Installing build tools",
          "root": true,
          "weight": 3,
          "expected_secs": 40,
          "percent": 20,
          "script": "installing-build-tools.sh"
        },
        {
          "label": "Building yay (as your user)",
          "weight": 10,
          "expected_secs": 120,
          "percent": 75,
          "script": "building-yay-as-your-user.sh"
        },
        {
          "label": "Installing yay",
          "root": true,
          "expected_secs": 10,
          "percent": 98,
          "script": "installing-yay.sh"
        }
      ],
      "on_success": "verify",
      "on_failure": "install_failed"
    },
    "verify": {
      "type": "check",
      "command": {
        "label": "Checking the result…",
        "timeout_secs": 60,
        "script": "checking-the-result.sh"
      },
      "capture": "verify_msg",
      "on_success": "record_install",
      "on_failure": "install_failed"
    },
    "record_install": {
      "type": "record",
      "set": {
        "installed_profile": "${profile}"
      },
      "packages": [
        "${new_pkgs}"
      ],
      "next": "done"
    },
    "done": {
      "type": "finish",
      "title": "yay installed",
      "success": true,
      "mark": "installed",
      "button": "Close",
      "message": [
        "yay is installed. Try it in a terminal: yay -Ss firefox"
      ]
    },
    "install_failed": {
      "type": "dialog",
      "title": "Installation failed",
      "tone": "error",
      "message": [
        "${last_failed}",
        "${verify_msg}",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    },
    "error_generic": {
      "type": "dialog",
      "title": "Something went wrong",
      "tone": "error",
      "message": "The system check could not run. Please try again.",
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    },
    "un_start": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "recorded_packages",
            "eq": ""
          },
          "goto": "un_nothing"
        }
      ],
      "default": "un_confirm"
    },
    "un_nothing": {
      "type": "finish",
      "title": "Nothing to remove",
      "success": true,
      "mark": "uninstalled",
      "button": "Close",
      "message": [
        "These codecs were already on your system before, so Tux Store keeps them.",
        "This add-on is now marked as not installed."
      ]
    },
    "un_confirm": {
      "type": "dialog",
      "title": "Remove AUR helper (yay)?",
      "tone": "warning",
      "message": [
        "yay will be removed. base-devel and git stay installed.",
        "",
        "You will be asked for your password."
      ],
      "buttons": [
        {
          "label": "Remove",
          "style": "danger",
          "goto": "un_preflight"
        },
        {
          "label": "Cancel",
          "exit": true
        }
      ]
    },
    "un_preflight": {
      "type": "check",
      "command": {
        "label": "Checking your system…",
        "script": "checking-your-system-2.sh"
      },
      "capture": "preflight",
      "on_success": "un_gate",
      "on_failure": "error_generic"
    },
    "un_gate": {
      "type": "branch",
      "cases": [
        {
          "when": {
            "var": "preflight",
            "ne": ""
          },
          "goto": "problem"
        }
      ],
      "default": "un_run"
    },
    "un_run": {
      "type": "run",
      "title": "Removing AUR helper (yay)…",
      "message": "Please don't turn off the computer until I'm finished.",
      "commands": [
        {
          "label": "Removing the codec packages",
          "root": true,
          "expected_secs": 20,
          "percent": 95,
          "script": "removing-the-codec-packages.sh"
        }
      ],
      "on_success": "un_done",
      "on_failure": "un_failed"
    },
    "un_done": {
      "type": "finish",
      "title": "Codecs removed",
      "success": true,
      "mark": "uninstalled",
      "button": "Close",
      "message": "The packages this add-on installed were removed. Packages that other software needs were kept."
    },
    "un_failed": {
      "type": "dialog",
      "title": "Removal failed",
      "tone": "error",
      "message": [
        "${last_failed}",
        "",
        "${last_output}"
      ],
      "buttons": [
        {
          "label": "Close",
          "exit": true
        }
      ]
    }
  }
}
