import { Theme } from "theme.slint";

export struct UiPackage {
    name: string,
    pretty_name: string,
    repo: string,
    version: string,
    description: string,
    installed: bool,
    icon: image,
}

export struct UiPackageDependency {
    name: string,
    size_str: string,
}

export struct UiPackageDetails {
    app_size_str: string,
    dependencies: [UiPackageDependency],
    total_deps_size_str: string,
    total_size_str: string,
    is_loading: bool,
}

component AppCard inherits Rectangle {
    in property <UiPackage> pkg;
    in property <int> accent_idx;
    callback clicked();

    background: ta.has-hover ? Theme.surface1 : Theme.surface0;
    border-color: ta.has-hover ? Theme.surface2 : Theme.surface1;
    border-width: 1px;
    border-radius: 12px;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            if pkg.icon.width > 0 : Image {
                source: pkg.icon;
                width: 64px;
                height: 64px;
            }
            if pkg.icon.width == 0 : Rectangle {
                width: 64px;
                height: 64px;
                background: Theme.accents[mod(root.accent_idx, Theme.accents.length)];
                border-radius: 12px;
                Text {
                    text: "↻";
                    color: Theme.crust;
                    font-size: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            spacing: 3px;
            Text {
                text: pkg.pretty_name;
                color: Theme.text;
                font-weight: 700;
                font-size: 14px;
                horizontal-alignment: center;
                overflow: elide;
            }
            Text {
                text: pkg.repo + " • " + pkg.version;
                color: Theme.overlay1;
                font-size: 11px;
                horizontal-alignment: center;
                overflow: elide;
            }
            Text {
                text: pkg.installed ? "Installed" : "Not Installed";
                color: pkg.installed ? Theme.green : Theme.overlay0;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
            }
        }
    }
}

component DetailsView inherits Rectangle {
    in property <UiPackage> pkg;
    in property <UiPackageDetails> details;
    in property <int> accent_idx;
    callback back_clicked();
    callback install_clicked();
    callback remove_clicked();

    background: Theme.base;

    Flickable {
        VerticalLayout {
            padding-left: 60px;
            padding-right: 60px;
            padding-top: 80px;
            padding-bottom: 60px;
            spacing: 28px;

            HorizontalLayout {
                spacing: 24px;
                if pkg.icon.width > 0 : Image {
                    source: pkg.icon;
                    width: 100px;
                    height: 100px;
                }
                if pkg.icon.width == 0 : Rectangle {
                    width: 100px;
                    height: 100px;
                    background: Theme.accents[mod(root.accent_idx, Theme.accents.length)];
                    border-radius: 20px;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: pkg.pretty_name;
                        color: Theme.text;
                        font-size: 32px;
                        font-weight: 400;
                        letter-spacing: -0.5px;
                    }
                    Text {
                        text: pkg.repo + " • " + pkg.version;
                        color: Theme.subtext0;
                        font-size: 15px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        alignment: start;
                        padding-top: 10px;
                        Rectangle {
                            width: 130px;
                            height: 38px;
                            background: pkg.installed ? Theme.red : Theme.accents[mod(root.accent_idx, Theme.accents.length)];
                            border-radius: 8px;
                            TouchArea {
                                clicked => {
                                    if pkg.installed { root.remove_clicked(); }
                                    else { root.install_clicked(); }
                                }
                            }
                            Text {
                                text: pkg.installed ? "Remove ✗" : "Install ✓";
                                color: Theme.crust;
                                font-size: 14px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.surface0; }

            Text {
                text: pkg.description;
                color: Theme.subtext1;
                font-size: 15px;
                wrap: word-wrap;
            }

            Rectangle {
                background: Theme.mantle;
                border-color: Theme.surface0;
                border-width: 1px;
                border-radius: 12px;
                
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;

                    if details.is_loading : Text {
                        text: "Fetching package details...";
                        color: Theme.overlay1;
                        font-size: 13px;
                    }

                    if !details.is_loading : VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: "Dependencies";
                            color: Theme.text;
                            font-size: 17px;
                            font-weight: 600;
                        }
                        if details.dependencies.length == 0 : Text {
                            text: "No additional packages required.";
                            color: Theme.subtext1;
                            font-size: 13px;
                        }
                        if details.dependencies.length > 0 : VerticalLayout {
                            spacing: 6px;
                            for dep in details.dependencies : HorizontalLayout {
                                Text { text: dep.name; color: Theme.subtext1; font-size: 13px; horizontal-stretch: 1; }
                                Text { text: dep.size_str; color: Theme.subtext0; font-size: 13px; }
                            }
                            Rectangle { height: 6px; }
                            Text {
                                text: "Total Dependencies Size: " + details.total_deps_size_str;
                                color: Theme.subtext0;
                                font-weight: 700;
                                font-size: 13px;
                            }
                        }
                        
                        Rectangle { height: 8px; }
                        Rectangle { height: 1px; background: Theme.surface0; }
                        Rectangle { height: 8px; }
                        
                        Text {
                            text: "App Size: " + details.app_size_str;
                            color: Theme.subtext1;
                            font-weight: 600;
                            font-size: 15px;
                        }
                        Text {
                            text: "Total (App + Deps): " + details.total_size_str;
                            color: Theme.accents[mod(root.accent_idx, Theme.accents.length)];
                            font-weight: 600;
                            font-size: 15px;
                        }
                    }
                }
            }
        }
    }
    
    Rectangle {
        x: 24px;
        y: 24px;
        width: 76px;
        height: 34px;
        background: btn-ta.has-hover ? Theme.surface1 : Theme.surface0;
        border-radius: 8px;
        border-color: Theme.surface1;
        border-width: 1px;
        btn-ta := TouchArea { clicked => { root.back_clicked(); } }
        Text {
            text: "⟨ Back";
            color: Theme.text;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    title: "Tux Store";
    preferred-width: 1100px;
    preferred-height: 800px;
    background: Theme.base;

    in property <[UiPackage]> packages: [];
    in property <bool> is_showing_details: false;
    in property <UiPackage> current_package;
    in property <UiPackageDetails> current_details;
    in-out property <string> search_query: "";
    
    callback search_changed(string);
    callback app_clicked(UiPackage);
    callback back_clicked();
    callback install_clicked(UiPackage);
    callback remove_clicked(UiPackage);

    if !is_showing_details : VerticalLayout {
        // Header bar
        Rectangle {
            height: 64px;
            background: Theme.mantle;
            border-color: Theme.surface0;
            border-width: 1px;
            
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                alignment: space-between;
                
                HorizontalLayout {
                    alignment: start;
                    spacing: 10px;
                    Text { text: "🐧"; font-size: 22px; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        Text { text: "Tux Store"; color: Theme.blue; font-size: 18px; font-weight: 700; }
                        Text { text: "for Arch Linux"; color: Theme.overlay1; font-size: 11px; }
                    }
                }
                
                                HorizontalLayout {
                    spacing: 12px;
                    y: 14px;
                    
                    Rectangle {
                        width: 40px;
                        height: 36px;
                        background: home-ta.has-hover ? Theme.surface1 : Theme.surface0;
                        border-radius: 10px;
                        border-color: Theme.surface1;
                        border-width: 1px;
                        home-ta := TouchArea {
                            clicked => {
                                root.search_query = "";
                                root.search_changed("");
                            }
                        }
                        Text {
                            text: "🏠";
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 260px;
                        height: 36px;
                        background: Theme.surface0;
                        border-radius: 10px;
                        border-color: Theme.surface1;
                        border-width: 1px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            TextInput {
                                text <=> root.search_query;
                                color: Theme.text;
                                font-size: 13px;
                                vertical-alignment: center;
                                accepted => { root.search_changed(self.text); }
                            }
                        }
                    }
                }
            }
        }
        
        // Responsive grid using absolute positioning
        grid-area := Flickable {
            property <length> card-w: 200px;
            property <length> card-h: 180px;
            property <length> gap: 16px;
            property <length> pad: 24px;
            property <int> cols: max(1, floor((self.width - pad * 2 + gap) / (card-w + gap)));
            property <int> total-rows: packages.length > 0 ? floor((packages.length + cols - 1) / cols) : 0;
            
            viewport-height: max(self.height, pad + total-rows * (card-h + gap));
            
            for pkg[idx] in root.packages : AppCard {
                x: grid-area.pad + mod(idx, grid-area.cols) * (grid-area.card-w + grid-area.gap);
                y: grid-area.pad + floor(idx / grid-area.cols) * (grid-area.card-h + grid-area.gap);
                width: grid-area.card-w;
                height: grid-area.card-h;
                pkg: pkg;
                accent_idx: idx;
                clicked => { root.app_clicked(pkg); }
            }
        }
    }

    if is_showing_details : DetailsView {
        pkg: root.current_package;
        details: root.current_details;
        accent_idx: 0;
        back_clicked => { root.back_clicked(); }
        install_clicked => { root.install_clicked(root.current_package); }
        remove_clicked => { root.remove_clicked(root.current_package); }
    }
}
