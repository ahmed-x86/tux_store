import { Theme } from "theme.slint";
import { UiPackage, UiPackageDependency, UiPackageDetails, UiInstallState, UiSpecialCase, UiAddon } from "types.slint";
import { SettingsView } from "settings_view.slint";
import { DetailsView } from "details_view.slint";
import { HomeTab } from "home_tab.slint";
import { SearchTab } from "search_tab.slint";
import { UpdateTab } from "update_tab.slint";
import { InstalledTab } from "installed_tab.slint";
import { AddonsStore } from "addons_store.slint";

export { UiPackage, UiPackageDependency, UiPackageDetails, UiInstallState, UiSpecialCase, UiAddon }

export component MainWindow inherits Window {
    title: "Tux Store";
    preferred-width: 1100px;
    preferred-height: 800px;
    background: Theme.base;

    in property <[UiPackage]> packages: [];
    in property <[UiPackage]> for_you: [];
    in property <[UiPackage]> browsers: [];
    in property <[UiPackage]> design: [];
    in property <[UiPackage]> utilities: [];
    in property <[UiPackage]> dev: [];
    in property <[UiPackage]> office: [];
    in property <[UiPackage]> communication: [];
    in property <[UiPackage]> addons_store_packages: [];
    in-out property <bool> is_showing_details: false;
    property <bool> is_showing_settings: false;
    property <bool> is_showing_addons_store: false;
    in property <UiPackage> current_package;
    in-out property <UiPackageDetails> current_details;
    in-out property <UiInstallState> current_install;
    in-out property <[UiPackage]> current_suggestions: [];
    in-out property <UiSpecialCase> current_special_case: { is_special: false, type_name: "", items: [], is_addon_for: "" };
    in-out property <string> search_query: "";
    property <string> submitted_search: "";
    property <int> active_tab: 0;

    callback search_changed(string);
    callback app_clicked(UiPackage);
    callback back_clicked();
    callback install_clicked(UiPackage);
    callback remove_clicked(UiPackage, string);
    callback open_url(string, string);
    callback addon_clicked(string);
    callback view_all_addons_clicked();
    callback copy_to_clipboard(string);

    if !is_showing_details && !is_showing_settings && !is_showing_addons_store : VerticalLayout {
        // Header bar
        Rectangle {
            height: 64px;
            background: Theme.mantle;
            border-color: Theme.surface0;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                alignment: space-between;

                HorizontalLayout {
                    alignment: start;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            settings_ta := TouchArea {
                                clicked => {
                                    root.is_showing_settings = true;
                                }
                            }
                            Image {
                                source: @image-url("settings.svg");
                                width: 22px;
                                height: 22px;
                                colorize: settings_ta.has-hover ? Theme.blue : Theme.text;
                                animate colorize { duration: 150ms; }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: "Tux Store"; color: Theme.blue; font-size: 18px; font-weight: 700; }
                        Text { text: "for Arch Linux"; color: Theme.overlay1; font-size: 11px; }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    y: 14px;

                    Rectangle {
                        width: 40px;
                        height: 36px;
                        background: home-ta.has-hover ? Theme.surface1 : Theme.surface0;
                        border-radius: 10px;
                        border-color: Theme.surface1;
                        border-width: 1px;
                        home-ta := TouchArea {
                            clicked => {
                                root.active_tab = 0;
                                root.search_query = "";
                                root.submitted_search = "";
                                root.search_changed("");
                            }
                        }
                        Image {
                            source: @image-url("home.svg");
                            width: 18px;
                            height: 18px;
                            colorize: home-ta.has-hover ? Theme.blue : Theme.text;
                            animate colorize { duration: 150ms; }
                        }
                    }

                    Rectangle {
                        width: 260px;
                        height: 36px;
                        background: Theme.surface0;
                        border-radius: 10px;
                        border-color: Theme.surface1;
                        border-width: 1px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            TextInput {
                                text <=> root.search_query;
                                color: Theme.text;
                                font-size: 13px;
                                vertical-alignment: center;
                                accepted => { 
                                    root.submitted_search = self.text;
                                    root.search_changed(self.text); 
                                }
                            }
                        }
                    }
                }
            }
        }

        // Tabs Bar
        Rectangle {
            height: 64px;
            background: Theme.base;

            Rectangle {
                x: 24px;
                width: parent.width - 48px;
                height: 44px;
                y: 10px;
                border-radius: 12px;
                background: Theme.crust;
                
                HorizontalLayout {
                    padding: 4px;
                    spacing: 4px;

                    // 1. Home
                    Rectangle {
                        min-width: 0px;
                        property <float> stretch: root.active_tab == 0 ? 1.5 : 1.0;
                        animate stretch { duration: 300ms; easing: ease-in-out; }
                        horizontal-stretch: stretch;
                        border-radius: 8px;
                        background: root.active_tab == 0 ? @linear-gradient(90deg, #cba6f7, #74c7ec) : (home-tab-ta.has-hover ? @linear-gradient(90deg, #cba6f7.transparentize(0.85), #74c7ec.transparentize(0.85)) : transparent);
                        drop-shadow-blur: root.active_tab == 0 ? 12px : (home-tab-ta.has-hover ? 8px : 0px);
                        drop-shadow-color: root.active_tab == 0 ? #cba6f7.transparentize(0.3) : (home-tab-ta.has-hover ? #cba6f7.transparentize(0.5) : transparent);
                        drop-shadow-offset-y: root.active_tab == 0 ? 3px : (home-tab-ta.has-hover ? 2px : 0px);
                        animate background { duration: 200ms; easing: ease-in-out; }
                        animate drop-shadow-blur { duration: 200ms; }
                        
                        home-tab-ta := TouchArea { clicked => { root.active_tab = 0; } }
                        Text { 
                            text: "Home"; 
                            color: root.active_tab == 0 ? Theme.crust : (home-tab-ta.has-hover ? #cba6f7 : Theme.overlay1); 
                            font-weight: root.active_tab == 0 ? 800 : 600; 
                            font-size: 14px; 
                            horizontal-alignment: center; vertical-alignment: center; 
                            animate color { duration: 200ms; }
                        }
                    }

                    // 2. Update System
                    Rectangle {
                        min-width: 0px;
                        property <float> stretch: root.active_tab == 1 ? 1.5 : 1.0;
                        animate stretch { duration: 300ms; easing: ease-in-out; }
                        horizontal-stretch: stretch;
                        border-radius: 8px;
                        background: root.active_tab == 1 ? @linear-gradient(90deg, #89b4fa, #b4befe) : (update-tab-ta.has-hover ? @linear-gradient(90deg, #89b4fa.transparentize(0.85), #b4befe.transparentize(0.85)) : transparent);
                        drop-shadow-blur: root.active_tab == 1 ? 12px : (update-tab-ta.has-hover ? 8px : 0px);
                        drop-shadow-color: root.active_tab == 1 ? #89b4fa.transparentize(0.3) : (update-tab-ta.has-hover ? #89b4fa.transparentize(0.5) : transparent);
                        drop-shadow-offset-y: root.active_tab == 1 ? 3px : (update-tab-ta.has-hover ? 2px : 0px);
                        animate background { duration: 200ms; easing: ease-in-out; }
                        animate drop-shadow-blur { duration: 200ms; }
                        
                        update-tab-ta := TouchArea { clicked => { root.active_tab = 1; } }
                        Text { 
                            text: "Update System"; 
                            color: root.active_tab == 1 ? Theme.crust : (update-tab-ta.has-hover ? #89b4fa : Theme.overlay1); 
                            font-weight: root.active_tab == 1 ? 800 : 600; 
                            font-size: 14px; 
                            horizontal-alignment: center; vertical-alignment: center; 
                            animate color { duration: 200ms; }
                        }
                    }

                    // 3. Installed Apps
                    Rectangle {
                        min-width: 0px;
                        property <float> stretch: root.active_tab == 2 ? 1.5 : 1.0;
                        animate stretch { duration: 300ms; easing: ease-in-out; }
                        horizontal-stretch: stretch;
                        border-radius: 8px;
                        background: root.active_tab == 2 ? @linear-gradient(90deg, #74c7ec, #89dceb) : (installed-tab-ta.has-hover ? @linear-gradient(90deg, #74c7ec.transparentize(0.85), #89dceb.transparentize(0.85)) : transparent);
                        drop-shadow-blur: root.active_tab == 2 ? 12px : (installed-tab-ta.has-hover ? 8px : 0px);
                        drop-shadow-color: root.active_tab == 2 ? #74c7ec.transparentize(0.3) : (installed-tab-ta.has-hover ? #74c7ec.transparentize(0.5) : transparent);
                        drop-shadow-offset-y: root.active_tab == 2 ? 3px : (installed-tab-ta.has-hover ? 2px : 0px);
                        animate background { duration: 200ms; easing: ease-in-out; }
                        animate drop-shadow-blur { duration: 200ms; }
                        
                        installed-tab-ta := TouchArea { clicked => { root.active_tab = 2; } }
                        Text { 
                            text: "Installed Apps"; 
                            color: root.active_tab == 2 ? Theme.crust : (installed-tab-ta.has-hover ? #74c7ec : Theme.overlay1); 
                            font-weight: root.active_tab == 2 ? 800 : 600; 
                            font-size: 14px; 
                            horizontal-alignment: center; vertical-alignment: center; 
                            animate color { duration: 200ms; }
                        }
                    }
                }
            }
        }

        // Active View
        if root.active_tab == 0 : Rectangle {
            if root.submitted_search != "" : SearchTab {
                packages: root.packages;
                app_clicked(pkg) => { root.app_clicked(pkg); }
            }
            if root.submitted_search == "" : HomeTab {
                for_you: root.for_you;
                browsers: root.browsers;
                communication: root.communication;
                design: root.design;
                office: root.office;
                dev: root.dev;
                utilities: root.utilities;
                app_clicked(pkg) => { root.app_clicked(pkg); }
            }
        }

        if root.active_tab == 1 : UpdateTab {}
        if root.active_tab == 2 : InstalledTab {}
    }

    if is_showing_details : DetailsView {
        pkg: root.current_package;
        details: root.current_details;
        install_state: root.current_install;
        suggestions: root.current_suggestions;
        special_case: root.current_special_case;
        accent_idx: 4;
        back_clicked => { root.back_clicked(); }
        install_clicked => { root.install_clicked(root.current_package); }
        remove_clicked(flags) => { root.remove_clicked(root.current_package, flags); }
        suggestion_clicked(pkg) => { root.app_clicked(pkg); }
        open_url(repo, name) => { root.open_url(repo, name); }
        addon_clicked(pkg_name) => {
            root.addon_clicked(pkg_name);
        }
        view_all_addons_clicked => {
            root.is_showing_addons_store = true;
            root.view_all_addons_clicked();
        }
        copy_to_clipboard(text) => {
            root.copy_to_clipboard(text);
        }
    }

    if is_showing_settings : SettingsView {
        back_clicked => { root.is_showing_settings = false; }
    }

    if is_showing_addons_store : AddonsStore {
        packages: root.addons_store_packages;
        store_title: root.current_special_case.type_name + " for " + root.current_package.pretty_name;
        back_clicked => { root.is_showing_addons_store = false; }
        app_clicked(pkg) => { 
            root.is_showing_addons_store = false;
            root.app_clicked(pkg); 
        }
    }
}
