import { Theme } from "theme.slint";

export struct UiPackage {
    name: string,
    pretty_name: string,
    repo: string,
    version: string,
    description: string,
    installed: bool,
    icon: image,
}

export struct UiPackageDependency {
    name: string,
    size_str: string,
    installed: bool,
}

export struct UiPackageDetails {
    app_size_str: string,
    dependencies: [UiPackageDependency],
    installed_deps_size_str: string,
    new_deps_size_str: string,
    download_size_str: string,
    // Proportions of the breakdown bar, each in [0, 1], summing to ~1.
    // Kept as pre-computed ratios (rather than raw bytes) so the UI never
    // needs to parse the display strings to size the bar segments.
    installed_ratio: float,
    new_ratio: float,
    app_ratio: float,
    // Mirrors pacman's own transaction summary line for line.
    total_download_str: string,
    total_installed_str: string,
    net_upgrade_str: string,
    is_loading: bool,
}

export struct UiInstallState {
    is_installing: bool,
    is_uninstalling: bool,
    finished: bool,
    success: bool,
    progress: float,      // 0..1 overall weighted progress
    deps_ratio: float,    // fraction of the bar that belongs to new deps
    console_log: string,
}

component AppCard inherits Rectangle {
    in property <UiPackage> pkg;
    in property <int> accent_idx;
    callback clicked();

    background: ta.has-hover ? Theme.surface1 : Theme.surface0;
    border-color: ta.has-hover ? Theme.surface2 : Theme.surface1;
    border-width: 1px;
    border-radius: 12px;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            if pkg.icon.width > 0 : Image {
                source: pkg.icon;
                width: 64px;
                height: 64px;
            }
            if pkg.icon.width == 0 : Rectangle {
                width: 64px;
                height: 64px;
                background: Theme.accents[mod(root.accent_idx, Theme.accents.length)];
                border-radius: 12px;
                Text {
                    text: "↻";
                    color: Theme.crust;
                    font-size: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            spacing: 3px;
            Text {
                text: pkg.pretty_name;
                color: Theme.text;
                font-weight: 700;
                font-size: 14px;
                horizontal-alignment: center;
                overflow: elide;
            }
            Text {
                text: pkg.repo + " • " + pkg.version;
                color: Theme.overlay1;
                font-size: 11px;
                horizontal-alignment: center;
                overflow: elide;
            }
            Text {
                text: pkg.installed ? "Installed" : "Not Installed";
                color: pkg.installed ? Theme.green : Theme.overlay0;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
            }
        }
    }
}

component SuggestionCard inherits Rectangle {
    in property <UiPackage> pkg;
    in property <int> accent_idx;
    callback clicked();

    width: 168px;
    height: 190px;
    background: sta.has-hover ? Theme.surface1 : Theme.surface0;
    border-color: sta.has-hover ? Theme.accents[mod(root.accent_idx, Theme.accents.length)] : Theme.surface1;
    border-width: 1px;
    border-radius: 14px;

    sta := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        alignment: start;

        if pkg.icon.width > 0 : Image {
            source: pkg.icon;
            width: 48px;
            height: 48px;
            horizontal-alignment: left;
        }
        if pkg.icon.width == 0 : Rectangle {
            width: 48px;
            height: 48px;
            background: Theme.accents[mod(root.accent_idx, Theme.accents.length)];
            border-radius: 10px;
        }

        VerticalLayout {
            spacing: 4px;
            Text {
                text: pkg.pretty_name;
                color: Theme.text;
                font-weight: 700;
                font-size: 13px;
                overflow: elide;
            }
            Text {
                text: pkg.repo;
                color: Theme.overlay1;
                font-size: 10px;
                overflow: elide;
            }
        }

        Rectangle { vertical-stretch: 1; }

        Text {
            text: pkg.installed ? "Installed" : "View details";
            color: pkg.installed ? Theme.green : Theme.accents[mod(root.accent_idx, Theme.accents.length)];
            font-size: 11px;
            font-weight: 700;
        }
    }
}

component AppRow inherits Rectangle {
    in property <string> title;
    in property <[UiPackage]> pkgs;
    in property <int> row_idx;
    callback clicked(UiPackage);

    height: pkgs.length > 0 ? 260px : 0px;
    clip: true;

    if pkgs.length > 0 : VerticalLayout {
        spacing: 12px;
        padding-left: 24px;
        padding-right: 24px;
        
        Text {
            text: root.title;
            font-size: 20px;
            font-weight: 800;
            color: Theme.text;
        }

        Rectangle {
            height: 190px;
            flick := Flickable {
                viewport-width: max(self.width, pkgs.length * (200px + 16px));
                
                HorizontalLayout {
                    spacing: 16px;
                    for pkg[idx] in root.pkgs : AppCard {
                        width: 200px;
                        height: 180px;
                        pkg: pkg;
                        accent_idx: root.row_idx * 10 + idx;
                        clicked => { root.clicked(pkg); }
                    }
                }
            }
        }

        // Custom horizontal scrollbar
        scroll-track := Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.surface0;
            
            property <length> content-width: max(flick.viewport-width, flick.width);
            property <length> visible-width: flick.width;
            property <length> thumb-width: max(36px, self.width * (visible-width / content-width));
            property <length> max-thumb-x: self.width - thumb-width;
            property <length> max-scroll: content-width - visible-width;
            property <length> thumb-x: max-thumb-x > 0px ? (-flick.viewport-x / max(1px, max-scroll)) * max-thumb-x : 0px;

            thumb := Rectangle {
                x: scroll-track.thumb-x;
                y: 0px;
                width: scroll-track.thumb-width;
                height: 6px;
                border-radius: 3px;
                background: thumb-ta.has-hover || thumb-ta.pressed ? Theme.blue : Theme.surface2;
            }

            thumb-ta := TouchArea {
                property <length> press-thumb-x: 0px;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down { press-thumb-x = scroll-track.thumb-x; }
                }
                moved => {
                    if self.pressed && scroll-track.max-thumb-x > 0px {
                        flick.viewport-x = -(max(0px, min(scroll-track.max-thumb-x, press-thumb-x + (self.mouse-x - self.pressed-x))) / scroll-track.max-thumb-x) * scroll-track.max-scroll;
                    }
                }
            }
        }
    }
}

component DepRow inherits Rectangle {
    in property <UiPackageDependency> dep;
    in property <color> accent;

    height: 34px;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;

        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 5px;
            background: dep.installed ? Theme.surface1 : root.accent.transparentize(0.82);
            Text {
                text: dep.installed ? "✓" : "↓";
                color: dep.installed ? Theme.overlay1 : root.accent;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: dep.name;
            color: dep.installed ? Theme.subtext0 : Theme.subtext1;
            font-size: 13px;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        Text {
            text: dep.size_str;
            color: dep.installed ? Theme.overlay1 : Theme.subtext0;
            font-size: 12px;
            font-weight: dep.installed ? 400 : 700;
            vertical-alignment: center;
        }
    }
}

component DetailsView inherits Rectangle {
    in property <UiPackage> pkg;
    in property <UiPackageDetails> details;
    in property <UiInstallState> install_state;
    in property <[UiPackage]> suggestions;
    in property <int> accent_idx;
    property <bool> show_console: false;
    property <bool> show_uninstall_modal: false;
    callback back_clicked();
    callback install_clicked();
    callback remove_clicked(string);
    callback suggestion_clicked(UiPackage);

    property <color> accent: Theme.accents[mod(root.accent_idx, Theme.accents.length)];

    background: Theme.base;

    VerticalLayout {
        // Top bar — same chrome as the home page, with Back where search usually sits.
        Rectangle {
            height: 64px;
            background: Theme.mantle;
            border-color: Theme.surface0;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                alignment: space-between;

                HorizontalLayout {
                    alignment: start;
                    spacing: 10px;
                    Text { text: "🐧"; font-size: 22px; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        Text { text: "Tux Store"; color: Theme.blue; font-size: 18px; font-weight: 700; }
                        Text { text: "for Arch Linux"; color: Theme.overlay1; font-size: 11px; }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    y: 14px;

                    Rectangle {
                        width: 90px;
                        height: 36px;
                        background: back-ta.has-hover ? Theme.surface1 : Theme.surface0;
                        border-radius: 10px;
                        border-color: Theme.surface1;
                        border-width: 1px;
                        back-ta := TouchArea { clicked => { root.back_clicked(); } }
                        Text {
                            text: "⟨ Back";
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        Flickable {
        VerticalLayout {
            padding-left: 64px;
            padding-right: 64px;
            padding-top: 40px;
            padding-bottom: 64px;
            spacing: 32px;
            alignment: start;

            // ---- Header ------------------------------------------------
            HorizontalLayout {
                spacing: 26px;

                if pkg.icon.width > 0 : Image {
                    source: pkg.icon;
                    width: 96px;
                    height: 96px;
                }
                if pkg.icon.width == 0 : Rectangle {
                    width: 96px;
                    height: 96px;
                    background: root.accent;
                    border-radius: 22px;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;
                        Text {
                            text: pkg.pretty_name;
                            color: Theme.text;
                            font-size: 30px;
                            font-weight: 700;
                            letter-spacing: -0.5px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: instTxt.width + 20px;
                            height: 24px;
                            border-radius: 12px;
                            background: pkg.installed ? Theme.green.transparentize(0.85) : Theme.surface1;
                            y: 3px;
                            instTxt := Text {
                                text: pkg.installed ? "Installed" : pkg.repo;
                                color: pkg.installed ? Theme.green : Theme.subtext0;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: pkg.description;
                        color: Theme.subtext0;
                        font-size: 14px;
                        wrap: word-wrap;
                        max-width: 560px;
                    }

                    Text {
                        text: "Version " + pkg.version;
                        color: Theme.overlay1;
                        font-size: 12px;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 152px;
                        height: 44px;
                        background: pkg.installed ? Theme.surface0 : root.accent;
                        border-color: pkg.installed ? Theme.red : root.accent;
                        border-width: pkg.installed ? 1px : 0px;
                        border-radius: 10px;
                        TouchArea {
                            clicked => {
                                if pkg.installed { root.show_uninstall_modal = true; }
                                else { root.install_clicked(); }
                            }
                        }
                        Text {
                            text: pkg.installed ? (install_state.is_uninstalling ? "Uninstalling…" : "Remove") : (install_state.is_installing ? "Installing…" : "Install");
                            color: pkg.installed ? Theme.red : Theme.crust;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // ---- Install progress ---------------------------------------
            if install_state.is_installing || install_state.is_uninstalling || install_state.finished : Rectangle {
                background: Theme.mantle;
                border-color: Theme.surface0;
                border-width: 1px;
                border-radius: 16px;

                VerticalLayout {
                    padding: 22px;
                    spacing: 14px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: !install_state.finished
                                ? (install_state.is_uninstalling ? "Uninstalling…" : (install_state.progress >= 0.98 ? "Finishing up…" : "Installing…"))
                                : (install_state.success ? (install_state.is_uninstalling ? "Uninstalled successfully" : "Installed successfully") : (install_state.is_uninstalling ? "Uninstallation failed" : "Installation failed"));
                            color: install_state.finished && !install_state.success ? Theme.red : Theme.text;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: round(install_state.progress * 100) + "%";
                            color: Theme.overlay1;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 10px;
                            border-radius: 5px;
                            background: Theme.surface1;
                            clip: true;
                            HorizontalLayout {
                                Rectangle {
                                    background: #89b4fa;
                                    horizontal-stretch: max(0.0001, min(install_state.progress, install_state.deps_ratio));
                                }
                                Rectangle {
                                    background: #cba6f7;
                                    horizontal-stretch: max(0.0001, max(0.0, install_state.progress - install_state.deps_ratio));
                                }
                                Rectangle {
                                    background: #6c7086;
                                    horizontal-stretch: max(0.0001,
                                        1.0 - min(install_state.progress, install_state.deps_ratio)
                                            - max(0.0, install_state.progress - install_state.deps_ratio));
                                }
                            }
                        }

                        Rectangle {
                            width: 100px;
                            height: 34px;
                            background: console-ta.has-hover ? Theme.surface1 : Theme.surface0;
                            border-color: Theme.surface2;
                            border-width: 1px;
                            border-radius: 8px;
                            console-ta := TouchArea { clicked => { root.show_console = !root.show_console; } }
                            Text {
                                text: "Console";
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // ---- Download summary --------------------------------------
            Rectangle {
                background: Theme.mantle;
                border-color: Theme.surface0;
                border-width: 1px;
                border-radius: 16px;

                VerticalLayout {
                    padding: 26px;
                    spacing: 18px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "What you'll download";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        if !details.is_loading : Text {
                            text: details.download_size_str;
                            color: root.accent;
                            font-size: 26px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    if details.is_loading : Text {
                        text: "Calculating download size…";
                        color: Theme.overlay1;
                        font-size: 13px;
                    }

                    if !details.is_loading : VerticalLayout {
                        spacing: 14px;

                        // Breakdown bar — segment widths are the real proportion
                        // of each part's size relative to the total footprint.
                        Rectangle {
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.surface1;
                            clip: true;
                            HorizontalLayout {
                                Rectangle { background: #6c7086; horizontal-stretch: max(0.0001, details.installed_ratio); }
                                Rectangle { background: #89b4fa; horizontal-stretch: max(0.0001, details.new_ratio); }
                                Rectangle { background: Theme.mauve; horizontal-stretch: max(0.0001, details.app_ratio); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 24px;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Rectangle { width: 9px; height: 9px; border-radius: 4.5px; background: #6c7086; y: 2px; }
                                Text {
                                    text: "Already on disk: " + details.installed_deps_size_str;
                                    color: Theme.subtext0;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Rectangle { width: 9px; height: 9px; border-radius: 4.5px; background: #89b4fa; y: 2px; }
                                Text {
                                    text: "New dependencies: " + details.new_deps_size_str;
                                    color: Theme.subtext0;
                                    font-size: 12px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Rectangle { width: 9px; height: 9px; border-radius: 4.5px; background: Theme.mauve; y: 2px; }
                                Text {
                                    text: "App itself: " + details.app_size_str;
                                    color: Theme.subtext0;
                                    font-size: 12px;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.surface0; }

                        // pacman-style transaction summary — the same three
                        // figures pacman itself prints before "Proceed with
                        // installation?", laid out as a clean stat row.
                        HorizontalLayout {
                            spacing: 0px;
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;
                                Text {
                                    text: "Total Download";
                                    color: Theme.overlay1;
                                    font-size: 11px;
                                }
                                Text {
                                    text: details.total_download_str;
                                    color: Theme.text;
                                    font-size: 17px;
                                    font-weight: 700;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;
                                Text {
                                    text: "Total Installed";
                                    color: Theme.overlay1;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: details.total_installed_str;
                                    color: Theme.text;
                                    font-size: 17px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                spacing: 4px;
                                alignment: end;
                                Text {
                                    text: "Net Upgrade";
                                    color: Theme.overlay1;
                                    font-size: 11px;
                                    horizontal-alignment: right;
                                }
                                Text {
                                    text: details.net_upgrade_str;
                                    color: root.accent;
                                    font-size: 17px;
                                    font-weight: 700;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }
                }
            }

            // ---- Dependencies list ---------------------------------------
            if !details.is_loading && details.dependencies.length > 0 : Rectangle {
                background: Theme.mantle;
                border-color: Theme.surface0;
                border-width: 1px;
                border-radius: 16px;

                VerticalLayout {
                    padding: 26px;
                    spacing: 4px;

                    Text {
                        text: "Dependencies (" + details.dependencies.length + ")";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                    }
                    Rectangle { height: 10px; }
                    for dep in details.dependencies : DepRow {
                        dep: dep;
                        accent: root.accent;
                    }
                }
            }

            if !details.is_loading && details.dependencies.length == 0 : Rectangle {
                background: Theme.mantle;
                border-color: Theme.surface0;
                border-width: 1px;
                border-radius: 16px;
                VerticalLayout {
                    padding: 26px;
                    Text {
                        text: "No additional dependencies required.";
                        color: Theme.subtext1;
                        font-size: 13px;
                    }
                }
            }

            // ---- Suggestions ------------------------------------------
            if suggestions.length > 0 : VerticalLayout {
                spacing: 14px;

                Text {
                    text: "You might also like";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }

                suggestions-flick := Flickable {
                    height: 190px;
                    viewport-width: suggestions.length * 184px;
                    interactive: true;

                    HorizontalLayout {
                        spacing: 16px;
                        for sug[sidx] in root.suggestions : SuggestionCard {
                            pkg: sug;
                            accent_idx: sidx + 1;
                            clicked => { root.suggestion_clicked(sug); }
                        }
                    }
                }

                // Custom horizontal scrollbar/slider for the shelf above —
                // draggable, and its thumb width reflects how much is visible.
                scroll-track := Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.surface0;

                    property <length> content-width: max(suggestions-flick.viewport-width, suggestions-flick.width);
                    property <length> visible-width: suggestions-flick.width;
                    property <length> thumb-width: max(36px, self.width * (visible-width / content-width));
                    property <length> max-thumb-x: self.width - thumb-width;
                    property <length> max-scroll: content-width - visible-width;
                    property <length> thumb-x: max-thumb-x > 0px
                        ? (-suggestions-flick.viewport-x / max(1px, max-scroll)) * max-thumb-x
                        : 0px;

                    thumb := Rectangle {
                        x: scroll-track.thumb-x;
                        y: 0px;
                        width: scroll-track.thumb-width;
                        height: 8px;
                        border-radius: 4px;
                        background: thumb-ta.has-hover || thumb-ta.pressed ? root.accent : Theme.surface2;
                    }

                    thumb-ta := TouchArea {
                        property <length> press-thumb-x: 0px;

                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                press-thumb-x = scroll-track.thumb-x;
                            }
                        }
                        moved => {
                            if self.pressed && scroll-track.max-thumb-x > 0px {
                                suggestions-flick.viewport-x = -(max(0px, min(scroll-track.max-thumb-x,
                                    press-thumb-x + (self.mouse-x - self.pressed-x))) / scroll-track.max-thumb-x) * scroll-track.max-scroll;
                            }
                        }
                    }
                }
            }
        }
        }
    }

    // ---- Console overlay: raw pacman output ---------------------------
    if root.show_console : Rectangle {
        background: Theme.crust.transparentize(0.15);
        TouchArea {} // swallows clicks behind the dialog

        Rectangle {
            x: 60px;
            y: 60px;
            width: parent.width - 120px;
            height: parent.height - 120px;
            background: Theme.mantle;
            border-color: Theme.surface1;
            border-width: 1px;
            border-radius: 14px;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "pacman output";
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 80px;
                        height: 30px;
                        background: close-ta.has-hover ? Theme.surface2 : Theme.surface1;
                        border-radius: 8px;
                        close-ta := TouchArea { clicked => { root.show_console = false; } }
                        Text {
                            text: "Close";
                            color: Theme.text;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.crust;
                    border-radius: 8px;
                    clip: true;
                    Flickable {
                        viewport-height: max(self.height, log-text.height + 20px);
                        log-text := Text {
                            x: 10px;
                            y: 10px;
                            width: parent.width - 20px;
                            text: install_state.console_log;
                            color: #a6e3a1;
                            font-size: 11px;
                            font-family: "monospace";
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // ---- Uninstall overlay ---------------------------------------------
    if root.show_uninstall_modal : Rectangle {
        background: Theme.crust.transparentize(0.15);
        TouchArea {} // swallows clicks behind the dialog

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: min(700px, root.width - 40px);
                    background: Theme.mantle;
            border-color: Theme.surface1;
            border-width: 1px;
            border-radius: 14px;

            VerticalLayout {
                padding: 30px;
                spacing: 20px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Uninstall " + pkg.pretty_name;
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 80px;
                        height: 30px;
                        background: close-uninstall-ta.has-hover ? Theme.surface2 : Theme.surface1;
                        border-radius: 8px;
                        close-uninstall-ta := TouchArea { clicked => { root.show_uninstall_modal = false; } }
                        Text {
                            text: "Cancel";
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: "Please select how you want to uninstall this package:";
                    color: Theme.subtext0;
                    font-size: 14px;
                }

                VerticalLayout {
                    spacing: 12px;
                    alignment: start;

                    // 1. -R
                    Rectangle {
                        background: r-ta.has-hover ? Theme.surface1 : Theme.surface0;
                        border-radius: 10px;
                        r-ta := TouchArea { clicked => { root.show_uninstall_modal = false; root.remove_clicked("-R"); } }
                        VerticalLayout {
                            padding: 16px; alignment: center; spacing: 4px;
                            Text { text: "Basic Uninstall"; color: Theme.text; font-size: 14px; font-weight: 700; wrap: word-wrap; }
                            Text { text: "Removes the app but keeps its settings and shared files."; color: Theme.overlay1; font-size: 12px; wrap: word-wrap; }
                        }
                    }

                    // 2. -Rn
                    Rectangle {
                        background: rn-ta.has-hover ? Theme.surface1 : Theme.surface0;
                        border-radius: 10px;
                        rn-ta := TouchArea { clicked => { root.show_uninstall_modal = false; root.remove_clicked("-Rn"); } }
                        VerticalLayout {
                            padding: 16px; alignment: center; spacing: 4px;
                            Text { text: "Uninstall and Reset"; color: Theme.text; font-size: 14px; font-weight: 700; wrap: word-wrap; }
                            Text { text: "Removes the app and deletes all its settings."; color: Theme.overlay1; font-size: 12px; wrap: word-wrap; }
                        }
                    }

                    // 3. -Rs
                    Rectangle {
                        background: rs-ta.has-hover ? Theme.surface1 : Theme.surface0;
                        border-radius: 10px;
                        rs-ta := TouchArea { clicked => { root.show_uninstall_modal = false; root.remove_clicked("-Rs"); } }
                        VerticalLayout {
                            padding: 16px; alignment: center; spacing: 4px;
                            Text { text: "Uninstall and Clean Shared Files"; color: Theme.text; font-size: 14px; font-weight: 700; wrap: word-wrap; }
                            Text { text: "Removes the app and shared files that are no longer needed. Keeps your settings."; color: Theme.overlay1; font-size: 12px; wrap: word-wrap; }
                        }
                    }

                    // 4. -Rdd
                    Rectangle {
                        background: rdd-ta.has-hover ? Theme.surface1 : Theme.surface0;
                        border-radius: 10px;
                        border-color: Theme.red;
                        border-width: 1px;
                        rdd-ta := TouchArea { clicked => { root.show_uninstall_modal = false; root.remove_clicked("-Rdd"); } }
                        VerticalLayout {
                            padding: 16px; alignment: center; spacing: 4px;
                            Text { text: "Force Uninstall (Advanced)"; color: Theme.red; font-size: 14px; font-weight: 700; wrap: word-wrap; }
                            Text { text: "Removes the app even if other apps rely on it. May break things!"; color: Theme.overlay1; font-size: 12px; wrap: word-wrap; }
                        }
                    }

                    // 5. -Rns
                    Rectangle {
                        background: rns-ta.has-hover ? Theme.surface2 : Theme.surface1;
                        border-radius: 10px;
                        border-color: Theme.green;
                        border-width: 1px;
                        rns-ta := TouchArea { clicked => { root.show_uninstall_modal = false; root.remove_clicked("-Rns"); } }
                        VerticalLayout {
                            padding: 16px; alignment: center; spacing: 4px;
                            Text { text: "Complete Uninstall (Recommended)"; color: Theme.green; font-size: 14px; font-weight: 700; wrap: word-wrap; }
                            Text { text: "Safely removes the app, deletes its settings, and cleans up all unneeded files."; color: Theme.overlay1; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
        }
        }
    }
}

export component MainWindow inherits Window {
    title: "Tux Store";
    preferred-width: 1100px;
    preferred-height: 800px;
    background: Theme.base;

    in property <[UiPackage]> packages: [];
    in property <[UiPackage]> for_you: [];
    in property <[UiPackage]> browsers: [];
    in property <[UiPackage]> design: [];
    in property <[UiPackage]> utilities: [];
    in property <[UiPackage]> dev: [];
    in property <[UiPackage]> office: [];
    in property <[UiPackage]> communication: [];
    in property <bool> is_showing_details: false;
    in property <UiPackage> current_package;
    in property <UiPackageDetails> current_details;
    in property <UiInstallState> current_install;
    in property <[UiPackage]> current_suggestions: [];
    in-out property <string> search_query: "";
    property <int> active_tab: 0;

    callback search_changed(string);
    callback app_clicked(UiPackage);
    callback back_clicked();
    callback install_clicked(UiPackage);
    callback remove_clicked(UiPackage, string);

    if !is_showing_details : VerticalLayout {
        // Header bar
        Rectangle {
            height: 64px;
            background: Theme.mantle;
            border-color: Theme.surface0;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                alignment: space-between;

                HorizontalLayout {
                    alignment: start;
                    spacing: 10px;
                    Text { text: "🐧"; font-size: 22px; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        Text { text: "Tux Store"; color: Theme.blue; font-size: 18px; font-weight: 700; }
                        Text { text: "for Arch Linux"; color: Theme.overlay1; font-size: 11px; }
                    }
                }

                                HorizontalLayout {
                    spacing: 12px;
                    y: 14px;

                    Rectangle {
                        width: 40px;
                        height: 36px;
                        background: home-ta.has-hover ? Theme.surface1 : Theme.surface0;
                        border-radius: 10px;
                        border-color: Theme.surface1;
                        border-width: 1px;
                        home-ta := TouchArea {
                            clicked => {
                                root.active_tab = 0;
                                root.search_query = "";
                                root.search_changed("");
                            }
                        }
                        Text {
                            text: "🏠";
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 260px;
                        height: 36px;
                        background: Theme.surface0;
                        border-radius: 10px;
                        border-color: Theme.surface1;
                        border-width: 1px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            TextInput {
                                text <=> root.search_query;
                                color: Theme.text;
                                font-size: 13px;
                                vertical-alignment: center;
                                accepted => { root.search_changed(self.text); }
                            }
                        }
                    }
                }
            }
        }

        // Tabs Bar (Glowing Gradient Segmented Control)
        Rectangle {
            height: 64px;
            background: Theme.base;

            Rectangle {
                x: 24px;
                width: parent.width - 48px;
                height: 44px;
                y: 10px;
                border-radius: 12px;
                background: Theme.crust;
                
                HorizontalLayout {
                    padding: 4px;
                    spacing: 4px;

                    // 1. Home
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: root.active_tab == 0 ? @linear-gradient(90deg, #cba6f7, #74c7ec) : (home-tab-ta.has-hover ? Theme.surface0 : transparent);
                        drop-shadow-blur: root.active_tab == 0 ? 12px : 0px;
                        drop-shadow-color: root.active_tab == 0 ? #cba6f7.transparentize(0.3) : transparent;
                        drop-shadow-offset-y: root.active_tab == 0 ? 3px : 0px;
                        animate background { duration: 200ms; easing: ease-in-out; }
                        animate drop-shadow-blur { duration: 200ms; }
                        
                        home-tab-ta := TouchArea { clicked => { root.active_tab = 0; } }
                        Text { 
                            text: "Home"; 
                            color: root.active_tab == 0 ? Theme.crust : Theme.overlay1; 
                            font-weight: root.active_tab == 0 ? 800 : 600; 
                            font-size: 14px; 
                            horizontal-alignment: center; vertical-alignment: center; 
                            animate color { duration: 200ms; }
                        }
                    }

                    // 2. Update System
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: root.active_tab == 1 ? @linear-gradient(90deg, #89b4fa, #b4befe) : (update-tab-ta.has-hover ? Theme.surface0 : transparent);
                        drop-shadow-blur: root.active_tab == 1 ? 12px : 0px;
                        drop-shadow-color: root.active_tab == 1 ? #89b4fa.transparentize(0.3) : transparent;
                        drop-shadow-offset-y: root.active_tab == 1 ? 3px : 0px;
                        animate background { duration: 200ms; easing: ease-in-out; }
                        animate drop-shadow-blur { duration: 200ms; }
                        
                        update-tab-ta := TouchArea { clicked => { root.active_tab = 1; } }
                        Text { 
                            text: "Update System"; 
                            color: root.active_tab == 1 ? Theme.crust : Theme.overlay1; 
                            font-weight: root.active_tab == 1 ? 800 : 600; 
                            font-size: 14px; 
                            horizontal-alignment: center; vertical-alignment: center; 
                            animate color { duration: 200ms; }
                        }
                    }

                    // 3. Installed Apps
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: root.active_tab == 2 ? @linear-gradient(90deg, #74c7ec, #89dceb) : (installed-tab-ta.has-hover ? Theme.surface0 : transparent);
                        drop-shadow-blur: root.active_tab == 2 ? 12px : 0px;
                        drop-shadow-color: root.active_tab == 2 ? #74c7ec.transparentize(0.3) : transparent;
                        drop-shadow-offset-y: root.active_tab == 2 ? 3px : 0px;
                        animate background { duration: 200ms; easing: ease-in-out; }
                        animate drop-shadow-blur { duration: 200ms; }
                        
                        installed-tab-ta := TouchArea { clicked => { root.active_tab = 2; } }
                        Text { 
                            text: "Installed Apps"; 
                            color: root.active_tab == 2 ? Theme.crust : Theme.overlay1; 
                            font-weight: root.active_tab == 2 ? 800 : 600; 
                            font-size: 14px; 
                            horizontal-alignment: center; vertical-alignment: center; 
                            animate color { duration: 200ms; }
                        }
                    }
                }
            }
        }

        // Home Tab
        if root.active_tab == 0 : Rectangle {
            if root.search_query != "" : grid-area := Flickable {
                property <length> card-w: 200px;
                property <length> card-h: 180px;
                property <length> gap: 16px;
                property <length> pad: 24px;
                property <int> cols: max(1, floor((self.width - pad * 2 + gap) / (card-w + gap)));
                property <int> total-rows: packages.length > 0 ? floor((packages.length + cols - 1) / cols) : 0;
                viewport-height: max(self.height, pad + total-rows * (card-h + gap));

                for pkg[idx] in root.packages : AppCard {
                    x: grid-area.pad + mod(idx, grid-area.cols) * (grid-area.card-w + grid-area.gap);
                    y: grid-area.pad + floor(idx / grid-area.cols) * (grid-area.card-h + grid-area.gap);
                    width: grid-area.card-w;
                    height: grid-area.card-h;
                    pkg: pkg;
                    accent_idx: idx;
                    clicked => { root.app_clicked(pkg); }
                }
            }
            if root.search_query == "" : home-feed := Flickable {
                viewport-height: feed-layout.preferred-height + 48px;
                feed-layout := VerticalLayout {
                    y: 24px;
                    spacing: 32px;
                    alignment: start;
                    AppRow { title: "For You"; pkgs: root.for_you; row_idx: 0; clicked(pkg) => { root.app_clicked(pkg); } }
                    AppRow { title: "Browsers"; pkgs: root.browsers; row_idx: 1; clicked(pkg) => { root.app_clicked(pkg); } }
                    AppRow { title: "Communication"; pkgs: root.communication; row_idx: 2; clicked(pkg) => { root.app_clicked(pkg); } }
                    AppRow { title: "Design & Multimedia"; pkgs: root.design; row_idx: 3; clicked(pkg) => { root.app_clicked(pkg); } }
                    AppRow { title: "Office & Productivity"; pkgs: root.office; row_idx: 4; clicked(pkg) => { root.app_clicked(pkg); } }
                    AppRow { title: "Development"; pkgs: root.dev; row_idx: 5; clicked(pkg) => { root.app_clicked(pkg); } }
                    AppRow { title: "Utilities"; pkgs: root.utilities; row_idx: 6; clicked(pkg) => { root.app_clicked(pkg); } }
                }
            }
        }

        // Placeholder for other tabs
        if root.active_tab != 0 : Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 12px;
                Text { text: "This feature is not implemented yet"; color: Theme.overlay1; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
            }
        }
    }

    if is_showing_details : DetailsView {
        pkg: root.current_package;
        details: root.current_details;
        install_state: root.current_install;
        suggestions: root.current_suggestions;
        accent_idx: 0;
        back_clicked => { root.back_clicked(); }
        install_clicked => { root.install_clicked(root.current_package); }
        remove_clicked(mode) => { root.remove_clicked(root.current_package, mode); }
        suggestion_clicked(sug) => { root.app_clicked(sug); }
    }
}
