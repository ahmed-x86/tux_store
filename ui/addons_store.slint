import { Theme } from "theme.slint";
import { UiPackage } from "types.slint";
import { AppCard } from "components.slint";

export component AddonsStore inherits Rectangle {
    in property <[UiPackage]> packages;
    in property <string> store_title: "Addons Store";
    callback back_clicked();
    callback app_clicked(UiPackage);

    background: Theme.base;

    VerticalLayout {
        // Top bar
        Rectangle {
            height: 64px;
            background: Theme.mantle;
            border-color: Theme.surface0;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                alignment: space-between;

                HorizontalLayout {
                    alignment: start;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            Image {
                                source: @image-url("settings.svg");
                                width: 22px;
                                height: 22px;
                                colorize: Theme.text;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: "Tux Store"; color: Theme.blue; font-size: 18px; font-weight: 700; }
                        Text { text: "for Arch Linux"; color: Theme.overlay1; font-size: 11px; }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    y: 14px;

                    Rectangle {
                        width: 90px;
                        height: 36px;
                        background: back-ta.has-hover ? Theme.surface1 : Theme.surface0;
                        border-radius: 10px;
                        border-color: Theme.surface1;
                        border-width: 1px;
                        back-ta := TouchArea { clicked => { root.back_clicked(); } }
                        Text {
                            text: "⟨ Back";
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Title
        Rectangle {
            height: 80px;
            HorizontalLayout {
                padding-left: 24px;
                alignment: start;
                Text {
                    text: root.store_title;
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
            }
        }

        // Grid
        Flickable {
            property <length> card-w: 200px;
            property <length> card-h: 180px;
            property <length> gap: 16px;
            property <length> pad: 24px;
            property <int> cols: max(1, floor((self.width - pad * 2 + gap) / (card-w + gap)));
            property <int> total-rows: packages.length > 0 ? floor((packages.length + cols - 1) / cols) : 0;
            viewport-height: max(self.height, pad + total-rows * (card-h + gap));

            for pkg[idx] in root.packages : AppCard {
                x: pad + mod(idx, cols) * (card-w + gap);
                y: pad + floor(idx / cols) * (card-h + gap);
                width: card-w;
                height: card-h;
                pkg: pkg;
                accent_idx: idx;
                clicked => { root.app_clicked(pkg); }
            }
        }
    }
}
