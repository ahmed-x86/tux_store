# Maintainer: you
# Build from a local checkout:  cd packaging && makepkg -si
pkgname=tux-store
pkgver=0.10.0
pkgrel=1
pkgdesc="Native Rust + Slint package store for Arch Linux (modular .so architecture)"
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('pacman' 'curl' 'polkit' 'util-linux' 'xdg-utils' 'fontconfig' 'libxkbcommon' 'libglvnd' 'pciutils')
makedepends=('cargo' 'pkgconf')
# makepkg's default LTO flags (-flto) are injected into the C/asm objects that
# Rust build scripts compile, which breaks linking of the module .so files.
options=('!lto' '!debug')
optdepends=('pacman-contrib: checkupdates, for a safe "Updates" tab')

build() {
  cd "$startdir/.."
  cargo build --release
}

package() {
  cd "$startdir/.."
  make install DESTDIR="$pkgdir" PREFIX=/usr
}
