# Maintainer: you
# Build from a local checkout:  cd packaging && makepkg -si
pkgname=tux-store
pkgver=1.0.0
pkgrel=1
pkgdesc="Native Rust + Slint package store for Arch Linux (modular .so architecture)"
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('pacman' 'curl' 'polkit' 'util-linux' 'xdg-utils' 'fontconfig' 'libxkbcommon' 'libglvnd' 'pciutils')
makedepends=('cargo' 'pkgconf' 'shared-mime-info' 'desktop-file-utils')
# makepkg's default LTO flags (-flto) are injected into the C/asm objects that
# Rust build scripts compile, which breaks linking of the module .so files.
options=('!lto' '!debug')
optdepends=('pacman-contrib: checkupdates, for a safe "Updates" tab')

build() {
  cd "$startdir/.."
  # "dist" is the slow, size-optimized profile (fat LTO, codegen-units=1)
  # defined in the workspace Cargo.toml; it outputs to target/dist/.
  cargo build --profile dist
}

package() {
  cd "$startdir/.."
  make install DESTDIR="$pkgdir" PREFIX=/usr
}

post_install() {
  update-mime-database /usr/share/mime
  update-desktop-database /usr/share/applications
}

post_upgrade() {
  post_install
}

post_remove() {
  update-mime-database /usr/share/mime
  update-desktop-database /usr/share/applications
}
