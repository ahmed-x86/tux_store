import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { UiPackage } from "types.slint";
import { PackageGrid, PillButton, TopBar, UnsupportedState } from "components.slint";

export component AddonsStore inherits Rectangle {
    in property <[UiPackage]> packages;
    in property <string> store-title: Strings.addons-title;
    in property <string> unsupported-text: "";
    in property <int> refresh-tick: 0;
    callback back-clicked();
    callback app-clicked(UiPackage);
    callback icons-needed(int, int);

    background: Theme.base;

    VerticalLayout {
        TopBar {
            PillButton { text: Strings.back-short; clicked => { root.back-clicked(); } }
        }

        Rectangle {
            height: 80px;
            HorizontalLayout {
                padding-left: 24px;
                alignment: start;
                Text { text: root.store-title; color: Theme.text; font-size: 24px; font-weight: 800; vertical-alignment: center; }
            }
        }

        PackageGrid {
            vertical-stretch: 1;
            packages: root.packages;
            refresh-tick: root.refresh-tick;
            empty-text: Strings.addons-loading;
            app-clicked(p) => { root.app-clicked(p); }
            icons-needed(first, last) => { root.icons-needed(first, last); }
        }
    }

    if root.unsupported-text != "" : Rectangle {
        y: 64px;
        width: parent.width;
        height: parent.height - 64px;
        background: Theme.base;
        UnsupportedState {
            width: parent.width;
            height: parent.height;
            message: root.unsupported-text;
        }
    }
}
