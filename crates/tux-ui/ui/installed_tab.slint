import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { UiPackage } from "types.slint";
import { PackageGrid, SearchBox } from "components.slint";

export component InstalledTab inherits Rectangle {
    in property <[UiPackage]> packages;
    in property <bool> loading;
    in property <bool> has-more;
    in property <int> total;
    in-out property <string> filter;
    in property <int> refresh-tick: 0;
    callback filter-edited(string);
    callback app-clicked(UiPackage);
    callback more-clicked();
    callback icons-needed(int, int);

    vertical-stretch: 1;

    VerticalLayout {
        HorizontalLayout {
            padding: 24px;
            padding-bottom: 8px;
            spacing: 12px;
            Text {
                text: root.loading ? Strings.installed-loading : (Strings.installed-count-prefix + root.total + ")");
                color: Theme.text;
                font-size: 20px;
                font-weight: 800;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                SearchBox {
                    text <=> root.filter;
                    placeholder: Strings.installed-filter;
                    edited(t) => { root.filter-edited(t); }
                }
            }
        }
        PackageGrid {
            vertical-stretch: 1;
            packages: root.packages;
            has-more: root.has-more;
            refresh-tick: root.refresh-tick;
            empty-text: root.loading ? "" : Strings.installed-empty;
            app-clicked(p) => { root.app-clicked(p); }
            more-clicked => { root.more-clicked(); }
            icons-needed(first, last) => { root.icons-needed(first, last); }
        }
    }
}
