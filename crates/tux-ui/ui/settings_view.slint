import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { PillButton, TopBar } from "components.slint";

component ChoiceButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();

    width: 110px;
    height: 36px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.selected ? Theme.blue : Theme.surface2;
    background: !root.enabled ? Theme.surface0.transparentize(0.5)
        : (root.selected ? Theme.blue.transparentize(0.85) : Theme.surface1);
    animate border-color { duration: 150ms; }
    animate background { duration: 150ms; }

    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: !root.enabled ? Theme.overlay0 : (root.selected ? Theme.blue : Theme.text);
        font-weight: root.selected ? 700 : 500;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SectionLabel inherits Rectangle {
    in property <string> text;
    HorizontalLayout {
        padding-left: 8px;
        Text { text: root.text; color: Theme.overlay1; font-size: 12px; font-weight: 800; letter-spacing: 1px; }
    }
}

component SettingCard inherits Rectangle {
    background: Theme.surface0;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.surface1;
    VerticalLayout {
        padding: 20px;
        spacing: 16px;
        @children
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    HorizontalLayout {
        alignment: space-between;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text { text: root.title; color: Theme.text; font-size: 16px; font-weight: 600; }
            Text { text: root.subtitle; color: Theme.overlay0; font-size: 13px; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 12px;
                @children
            }
        }
    }
}

export component SettingsView inherits Rectangle {
    in property <string> app-version;
    in property <string> cache-status;
    in property <string> engine;
    in property <bool> engine-enabled: true;
    in property <string> backend-message;
    callback back-clicked();
    callback theme-selected(bool);
    callback engine-selected(string);
    callback clear-cache-clicked();

    background: Theme.base;

    VerticalLayout {
        TopBar {
            PillButton { text: Strings.back-short; clicked => { root.back-clicked(); } }
        }

        Flickable {
            content-height: main-layout.preferred-height;

            HorizontalLayout {
                padding-left: 32px;
                padding-right: 32px;

                Rectangle { horizontal-stretch: 1; }

                main-layout := VerticalLayout {
                    horizontal-stretch: 1000;
                    max-width: 800px;
                    padding-top: 40px;
                    padding-bottom: 64px;
                    spacing: 32px;
                    alignment: start;

                    Text { text: Strings.settings-title; color: Theme.text; font-size: 28px; font-weight: 800; }

                    VerticalLayout {
                        spacing: 12px;
                        SectionLabel { text: Strings.settings-appearance; }
                        SettingCard {
                            SettingRow {
                                title: Strings.settings-app-theme;
                                subtitle: Strings.settings-theme-desc;
                                ChoiceButton {
                                    label: Strings.theme-light;
                                    selected: !Theme.is-dark;
                                    clicked => { Theme.is-dark = false; root.theme-selected(false); }
                                }
                                ChoiceButton {
                                    label: Strings.theme-dark;
                                    selected: Theme.is-dark;
                                    clicked => { Theme.is-dark = true; root.theme-selected(true); }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 12px;
                        SectionLabel { text: Strings.settings-engine-section; }
                        SettingCard {
                            SettingRow {
                                title: Strings.settings-engine;
                                subtitle: Strings.settings-engine-desc;
                                ChoiceButton {
                                    label: Strings.engine-direct;
                                    width: 150px;
                                    selected: root.engine == "direct";
                                    enabled: root.engine-enabled;
                                    clicked => { root.engine-selected("direct"); }
                                }
                                ChoiceButton {
                                    label: Strings.engine-libalpm;
                                    width: 110px;
                                    selected: root.engine == "libalpm";
                                    enabled: root.engine-enabled;
                                    clicked => { root.engine-selected("libalpm"); }
                                }
                            }
                            if root.backend-message != "" : Text {
                                text: root.backend-message;
                                color: Theme.overlay1;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 12px;
                        SectionLabel { text: Strings.settings-storage; }
                        SettingCard {
                            SettingRow {
                                title: Strings.settings-cache;
                                subtitle: root.cache-status == "" ? Strings.settings-cache-desc : root.cache-status;
                                PillButton { text: Strings.clear-cache; clicked => { root.clear-cache-clicked(); } }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 12px;
                        SectionLabel { text: Strings.settings-about; }
                        SettingCard {
                            SettingRow {
                                title: Strings.app-name;
                                subtitle: Strings.settings-version-prefix + root.app-version + Strings.settings-about-desc;
                            }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}