import { Theme } from "theme.slint";
import { PillButton, TopBar } from "components.slint";

component ChoiceButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    width: 110px;
    height: 36px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.selected ? Theme.blue : Theme.surface2;
    background: root.selected ? Theme.blue.transparentize(0.85) : Theme.surface1;
    animate border-color { duration: 150ms; }
    animate background { duration: 150ms; }

    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: root.selected ? Theme.blue : Theme.text;
        font-weight: root.selected ? 700 : 500;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SectionLabel inherits Rectangle {
    in property <string> text;
    HorizontalLayout {
        padding-left: 8px;
        Text { text: root.text; color: Theme.overlay1; font-size: 12px; font-weight: 800; letter-spacing: 1px; }
    }
}

component SettingCard inherits Rectangle {
    background: Theme.surface0;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.surface1;
    VerticalLayout {
        padding: 20px;
        spacing: 16px;
        @children
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    HorizontalLayout {
        alignment: space-between;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text { text: root.title; color: Theme.text; font-size: 16px; font-weight: 600; }
            Text { text: root.subtitle; color: Theme.overlay0; font-size: 13px; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 12px;
                @children
            }
        }
    }
}

export component SettingsView inherits Rectangle {
    in property <string> app-version;
    in property <string> cache-status;
    in property <string> engine;
    callback back-clicked();
    callback theme-selected(bool);
    callback engine-selected(string);
    callback clear-cache-clicked();

    background: Theme.base;

    VerticalLayout {
        TopBar {
            PillButton { text: "⟨ Back"; clicked => { root.back-clicked(); } }
        }

        Flickable {
            content-height: main-layout.preferred-height;

            HorizontalLayout {
                padding-left: 32px;
                padding-right: 32px;

                Rectangle { horizontal-stretch: 1; }

                main-layout := VerticalLayout {
                    horizontal-stretch: 1000;
                    max-width: 800px;
                    padding-top: 40px;
                    padding-bottom: 64px;
                    spacing: 32px;
                    alignment: start;

                    Text { text: "Settings"; color: Theme.text; font-size: 28px; font-weight: 800; }

                    VerticalLayout {
                        spacing: 12px;
                        SectionLabel { text: "APPEARANCE"; }
                        SettingCard {
                            SettingRow {
                                title: "App Theme";
                                subtitle: "Select your preferred color scheme";
                                ChoiceButton {
                                    label: "Light";
                                    selected: !Theme.is-dark;
                                    clicked => { Theme.is-dark = false; root.theme-selected(false); }
                                }
                                ChoiceButton {
                                    label: "Dark";
                                    selected: Theme.is-dark;
                                    clicked => { Theme.is-dark = true; root.theme-selected(true); }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 12px;
                        SectionLabel { text: "PACKAGE ENGINE"; }
                        SettingCard {
                            SettingRow {
                                title: "Engine";
                                subtitle: "How Tux Store asks pacman questions and runs transactions. Direct commands start a pacman process for every operation; libalpm talks to the library directly.";
                                ChoiceButton {
                                    label: "Direct pacman";
                                    width: 150px;
                                    selected: root.engine == "direct";
                                    clicked => { root.engine-selected("direct"); }
                                }
                                ChoiceButton {
                                    label: "libalpm";
                                    width: 110px;
                                    selected: root.engine == "libalpm";
                                    clicked => { root.engine-selected("libalpm"); }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 12px;
                        SectionLabel { text: "STORAGE"; }
                        SettingCard {
                            SettingRow {
                                title: "Cache";
                                subtitle: root.cache-status == "" ? "Downloaded icons and other cached data (~/.cache/tux-store). Clearing also re-reads your icon theme" : root.cache-status;
                                PillButton { text: "Clear cache"; clicked => { root.clear-cache-clicked(); } }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 12px;
                        SectionLabel { text: "ABOUT"; }
                        SettingCard {
                            SettingRow {
                                title: "Tux Store";
                                subtitle: "Version " + root.app-version + " — a native package store for Arch Linux";
                            }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}